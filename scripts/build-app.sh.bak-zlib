#!/usr/bin/env bash
# Builds PS5LM's native app: llama-server with ggml-vulkan on RADV, as a title
# folder (eboot.bin, sce_sys/param.json, sce_module/libc.prx) for
# ShadowMountPlus, in build/app-ps5/title/<TITLE_ID>. The icon and the
# backgrounds come from ps5/app/sce_sys (sources in its source/ folder).
#
# Needs PS5_Vulkan next to its forks (.deps/src: PS5_Vulkan, PS5_Mesa,
# PS5_PayloadSDK), set up with its tools/setup-native-dependencies.sh,
# tools/build-radv.sh release and `make app` (for the host tool and libc.prx).
#
#   scripts/build-app.sh            configure, build and package
#   PS5LM_PREBUILT_UI=OFF ...       omit the optional downloaded browser UI
# CMAKE_BUILD_PARALLEL_LEVEL also bounds the native dashboard compilers.
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
vk=${PS5_VULKAN_ROOT:-$root/.deps/src/PS5_Vulkan}
sdk="$vk/.deps/native/ps5-payload-sdk"
radv="$vk/.deps/native/radv-release"
archive="$radv/lib/libvulkan_radeon.ps5.a"
tool="$vk/build/host/ps5-native-tool"
llama="$root/third_party/llama.cpp"
# The image engine: stable-diffusion.cpp with its own ggml, beside llama.cpp's.
sd="$root/third_party/stable-diffusion.cpp"
sggml="$sd/ggml"
out="$root/build/app-ps5"
headers="$root/.deps/ps5-vk-headers"
# ps5-opengl comes pinned and sha256-checked through the submodule's own script.
glsdk=${PS5_OPENGL_SDK:-$(bash "$root/third_party/ps5-homebrew-ui/tools/fetch-opengl-sdk.sh")}
sce_sys="$root/ps5/app/sce_sys"
param="$sce_sys/param.json"

for f in "$archive" "$tool" "$vk/runtime/libc.prx" "$sdk/bin/prospero-lld" "$glsdk/lib/libPS5OpenGL.a"; do
    [ -e "$f" ] || { echo "build-app: missing $f" >&2; exit 2; }
done
export PS5_PAYLOAD_SDK="$sdk" PS5_VULKAN_ROOT="$vk"

# radv-link.sh takes Clang's builtins from <resource dir>/lib/linux/, where
# Debian and Arch put them; Fedora keeps them under the target triple. A clang
# that reports a resource dir with that layout covers both.
builtins=$(clang --print-file-name=libclang_rt.builtins.a)
[ -f "$builtins" ] || builtins="$(clang --print-resource-dir)/lib/linux/libclang_rt.builtins-x86_64.a"
shim="$root/.deps/clang-shim"
mkdir -p "$shim/resource/lib/linux"
ln -sf "$builtins" "$shim/resource/lib/linux/libclang_rt.builtins-x86_64.a"
printf '#!/bin/sh\n[ "$1" = --print-resource-dir ] && { echo "%s"; exit 0; }\nexec clang "$@"\n' \
    "$shim/resource" > "$shim/clang"
chmod +x "$shim/clang"

# The Vulkan and SPIR-V headers, copied out of the host's /usr/include so the
# cross build never sees the host's libc headers next to them.
if [ ! -f "$headers/include/vulkan/vulkan.hpp" ]; then
    mkdir -p "$headers/include" "$headers/cmake"
    cp -r /usr/include/vulkan /usr/include/vk_video /usr/include/spirv "$headers/include/"
    cat > "$headers/cmake/SPIRV-HeadersConfig.cmake" <<EOF
add_library(SPIRV-Headers::SPIRV-Headers INTERFACE IMPORTED)
set_target_properties(SPIRV-Headers::SPIRV-Headers PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "$headers/include")
set(SPIRV-Headers_FOUND TRUE)
EOF
fi

# The PS5 changes to llama.cpp (patches/), as scripts/build-llama.sh applies them.
for p in "$root"/patches/*.patch; do
    git -C "$llama" apply --reverse --check "$p" 2>/dev/null || git -C "$llama" apply "$p"
done
# stable-diffusion.cpp and its ggml: their own PS5 series (patches/sdcpp, patches/sdggml).
for p in "$root"/patches/sdggml/*.patch; do
    [ -e "$p" ] || continue
    git -C "$sggml" apply --reverse --check "$p" 2>/dev/null || git -C "$sggml" apply "$p"
done
for p in "$root"/patches/sdcpp/*.patch; do
    [ -e "$p" ] || continue
    git -C "$sd" apply --reverse --check "$p" 2>/dev/null || git -C "$sd" apply "$p"
done

flags="-DSUBPROCESS_HAVE_CWD=0 -I$headers/include"
# llama.cpp throws, catches and uses dynamic_cast; the PS5 target turns
# exceptions and RTTI off by default.
cxxflags="$flags -fexceptions -fcxx-exceptions -frtti"
mkdir -p "$out"
cmake -S "$llama" -B "$out/llama" -G Ninja \
    -DCMAKE_TOOLCHAIN_FILE="$root/ps5/app/toolchain.cmake" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_C_FLAGS="$flags" -DCMAKE_CXX_FLAGS="$cxxflags" \
    -DBUILD_SHARED_LIBS=OFF -DGGML_BACKEND_DL=OFF -DGGML_NATIVE=OFF -DGGML_CPU_ALL_VARIANTS=OFF \
    -DGGML_AVX=ON -DGGML_AVX2=ON -DGGML_FMA=ON -DGGML_F16C=ON -DGGML_BMI2=ON -DGGML_AVX512=OFF \
    -DGGML_OPENMP=OFF -DGGML_CCACHE=OFF -DGGML_VULKAN=ON \
    -DVulkan_INCLUDE_DIR="$headers/include" -DVulkan_LIBRARY="$archive" \
    -DVulkan_GLSLC_EXECUTABLE="$(command -v glslc)" -DSPIRV-Headers_DIR="$headers/cmake" \
    -DMATH_LIBRARY=SceLibcInternal \
    -DCMAKE_SKIP_INSTALL_RPATH=ON -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON \
    -DLLAMA_OPENSSL=OFF -DLLAMA_BUILD_COMMON=ON -DLLAMA_BUILD_TESTS=OFF -DLLAMA_BUILD_EXAMPLES=OFF \
    -DLLAMA_BUILD_TOOLS=ON -DLLAMA_BUILD_SERVER=ON \
    -ULLAMA_BUILD_WEBUI -ULLAMA_USE_PREBUILT_WEBUI \
    -DLLAMA_BUILD_UI=OFF -DLLAMA_USE_PREBUILT_UI="${PS5LM_PREBUILT_UI:-ON}" > "$out.configure.log" 2>&1 ||
    { tail -30 "$out.configure.log" >&2; exit 1; }
cmake --build "$out/llama" --target llama-server-impl

# ---- stable-diffusion.cpp and its ggml: the image engine --------------------
# A second ggml in the same binary. The two share thousands of symbol names;
# the sd one is linked as a single object with only its own API left global
# (below), as ps5-opengl's Mesa is next to RADV's. Rebuilt when it changes.
cmake -S "$sd" -B "$out/sd" -G Ninja \
    -DCMAKE_TOOLCHAIN_FILE="$root/ps5/app/toolchain.cmake" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_C_FLAGS="$flags" -DCMAKE_CXX_FLAGS="$cxxflags" \
    -DBUILD_SHARED_LIBS=OFF -DSD_BUILD_SHARED_LIBS=OFF -DSD_BUILD_EXAMPLES=OFF \
    -DSD_VULKAN=ON \
    -DGGML_BACKEND_DL=OFF -DGGML_NATIVE=OFF -DGGML_CPU_ALL_VARIANTS=OFF \
    -DGGML_AVX=ON -DGGML_AVX2=ON -DGGML_FMA=ON -DGGML_F16C=ON -DGGML_BMI2=ON -DGGML_AVX512=OFF \
    -DGGML_OPENMP=OFF -DGGML_CCACHE=OFF \
    -DVulkan_INCLUDE_DIR="$headers/include" -DVulkan_LIBRARY="$archive" \
    -DVulkan_GLSLC_EXECUTABLE="$(command -v glslc)" -DSPIRV-Headers_DIR="$headers/cmake" \
    -DMATH_LIBRARY=SceLibcInternal > "$out/sd.configure.log" 2>&1 ||
    { tail -30 "$out/sd.configure.log" >&2; exit 1; }
cmake --build "$out/sd" --target stable-diffusion

# The app's own objects, and the title's start code from PS5_Vulkan.
obj="$out/obj"
mkdir -p "$obj" "$out/stubs"
cxx() { "$root/ps5/app/ps5cxx" -std=c++17 -O2 -ffunction-sections -fdata-sections "$@"; }
cxx -std=c++20 -fexceptions -fcxx-exceptions -frtti -I "$headers/include" -I "$llama/ggml/include" -I "$root/third_party/ps5-homebrew-ui/src" \
    -I "$glsdk/include" -DGL_GLEXT_PROTOTYPES=1 \
    -c "$root/ps5/app/main.cpp" -o "$obj/main.o"
cxx -fexceptions -fcxx-exceptions -c "$root/ps5/app/model_plan.cpp" -o "$obj/model_plan.o"
cxx -std=c++20 -fexceptions -fcxx-exceptions -I "$llama/include" -I "$llama/ggml/include" -I "$root/ps5/app" -c "$root/ps5/app/adaptive.cpp" -o "$obj/adaptive.o"
# The speech engine: llama.cpp's mtmd (Qwen3-TTS voice cloning) in this process, beside the text one.
cxx -std=c++20 -fexceptions -fcxx-exceptions -I "$llama/include" -I "$llama/ggml/include" -I "$llama/tools/mtmd" -I "$llama/vendor" -c "$root/ps5/app/tts_server.cpp" -o "$obj/tts_server.o"
# The image engine: stable-diffusion.cpp and its own ggml, in this process.
cxx -std=c++20 -fexceptions -fcxx-exceptions -I "$sd/include" -I "$sd/thirdparty" -I "$sggml/include" -I "$llama/vendor" -c "$root/ps5/app/sd_server.cpp" -o "$obj/sd_server.o"
# The media engine: FFmpeg, hung under the picture engine's port.
avlibs=()
if [ -d /home/yk/ext/ffmpeg ]; then
    cxx -std=c++17 -O2 -fexceptions -fcxx-exceptions \
        -I /home/yk/ext/ffmpeg -I "$root/ps5/app" -I "$llama/vendor" \
        -c "$root/ps5/app/media_server.cpp" -o "$obj/media_server.o"
    for a in libavformat libavcodec libavutil libswscale; do
        [ -f "/home/yk/ext/ffmpeg/$a/$a.a" ] && avlibs+=("/home/yk/ext/ffmpeg/$a/$a.a")
    done
    echo "build-app: media engine: ${#avlibs[@]} libav archive(s)"

# The interpolation engine: RIFE on ncnn (the ncnn commit rife pins) + glslang.
rifelibs=()
rifeobj=()
if [ -d /tmp/rife-shd ] && [ -f /home/yk/ext/ncnn-rife/build-ps5vk/src/libncnn.a ]; then
    RIFE_SRC=/home/yk/ext/rife-ncnn/src
    NCNN_RIFE=/home/yk/ext/ncnn-rife
    VKH="$root/.deps/ps5-vk-headers/include"
    RFLAGS="-std=c++17 -O2 -fPIC -fexceptions -fcxx-exceptions -DNCNN_VULKAN=1 -DNCNN_STATIC_DEFINE"
    RINC="-I $RIFE_SRC -I /tmp/rife-shd -I $NCNN_RIFE/src -I $NCNN_RIFE/build-ps5vk/src -I $VKH -I $root/ps5/app -I $llama/vendor"
    cxx $RFLAGS $RINC -c "$RIFE_SRC/rife.cpp" -o "$obj/rife.o"
    cxx $RFLAGS $RINC -c "$RIFE_SRC/warp.cpp" -o "$obj/rife_warp.o"
    cxx $RFLAGS $RINC -c "$root/ps5/app/interp_server.cpp" -o "$obj/interp_server.o"
    rifeobj=("$obj/rife.o" "$obj/rife_warp.o" "$obj/interp_server.o")
    rifelibs=("$NCNN_RIFE/build-ps5vk/src/libncnn.a")
    for a in libglslang libSPIRV libMachineIndependent libGenericCodeGen libOSDependent libglslang-default-resource-limits; do
        f=/home/yk/ext/glslang/prefix/lib/$a.a
        [ -f "$f" ] && rifelibs+=("$f")
    done
    echo "build-app: interp engine: ${#rifeobj[@]} object(s) + ${#rifelibs[@]} archive(s)"
else
    echo "build-app: interp engine: not linked (no /tmp/rife-shd or no ncnn-rife build)"
fi
else
    echo "build-app: media engine: not linked (no /home/yk/ext/ffmpeg)"
fi
# The 3D engine: TRELLIS.2 (image -> 3D), a fourth ggml, TRX_ prefixed.
# trellis_run lives in trellis_cli.cpp (not in any archive), so compile it here
# and objcopy the resulting object with the same rename list the libraries got:
# its references to ggml/xatlas must end up TRX_-prefixed too.
trellis_src=${TRELLIS_SRC:-/home/yk/ext/trellis.cpp}
trellis_obj=()
if [ -d "$root/.deps/trellis-trx" ] && [ -d "$trellis_src" ]; then
    cxx -std=c++20 -fexceptions -fcxx-exceptions \
        -I "$trellis_src/include" -I "$trellis_src/src" -I "$trellis_src/thirdparty/ggml/include" \
        -I "$trellis_src/thirdparty/stb" -I "$trellis_src/thirdparty" \
        -I "$root/ps5/app" -I "$llama/vendor" \
        -c "$trellis_src/src/trellis_cli.cpp" -o "$obj/trellis_run.raw.o"
    "$sdk/bin/llvm-objcopy" --redefine-syms="$root/.deps/trellis-trx/rename.txt" \
        "$obj/trellis_run.raw.o" "$obj/trellis_run.o"
    cxx -std=c++20 -fexceptions -fcxx-exceptions \
        -I "$trellis_src/include" -I "$trellis_src/src" -I "$trellis_src/thirdparty/ggml/include" \
        -I "$root/ps5/app" -I "$llama/vendor" \
        -c "$root/ps5/app/trellis_server.cpp" -o "$obj/trellis_server.o"
    trellis_obj=("$obj/trellis_run.o" "$obj/trellis_server.o")
    echo "build-app: 3D engine: trellis_run.o (TRX_ prefixed) + trellis_server.o"
else
    echo "build-app: 3D engine: not linked (no .deps/trellis-trx or no $trellis_src)"
fi

# The audio engine: audio.cpp's C ABI, a third ggml, ACX_ prefixed at link time.
# Only built when .deps/audio-acx exists — without it the C API is unreachable
# and the object would fail to link.
if [ -d "$root/.deps/audio-acx" ]; then
    cxx -std=c++20 -fexceptions -fcxx-exceptions -I "$root/ps5/app" -I "$llama/vendor" -c "$root/ps5/app/audio_server.cpp" -o "$obj/audio_server.o"
    audio_obj=("$obj/audio_server.o")
else
    audio_obj=()
fi
cxx -std=c++20 -fexceptions -fcxx-exceptions -I "$llama/vendor" -c "$root/ps5/app/settings.cpp" -o "$obj/settings.o"
cxx -std=c++20 -fexceptions -fcxx-exceptions -c "$root/ps5/app/fetch.cpp" -o "$obj/fetch.o"
cxx -std=c++20 -fexceptions -fcxx-exceptions -I "$llama/vendor" -c "$root/ps5/app/market.cpp" -o "$obj/market.o"
cxx -std=c++20 -fexceptions -fcxx-exceptions -I "$llama/vendor" -I "$root/ps5/app" -I "$root/third_party/ps5-homebrew-ui/src" -c "$root/ps5/app/activity.cpp" -o "$obj/activity.o"
"$root/ps5/app/ps5cc" -O2 -I "$llama/vendor/hash" -c "$llama/vendor/hash/sha256/sha256.c" -o "$obj/sha256.o"
"$root/ps5/app/ps5cc" -O2 -c "$root/ps5/app/compat_app.c" -o "$obj/compat_app.o"
# The console has no __tls_init: sd.cpp's thread_local executor leaves weak
# undefined _ZTH wrappers that the title converter rejects. Empty bodies.
"$root/ps5/app/ps5cc" -O2 -c "$root/ps5/app/tls_stub.c" -o "$obj/tls_stub.o"
# In an archive, so --exclude-libs keeps them local: a stub module defines some
# of the same names, and lld would otherwise export ours to interpose them,
# which the title converter refuses.
rm -f "$obj/libps5app_compat.a"
"$sdk/bin/llvm-ar" rcs "$obj/libps5app_compat.a" "$obj/compat_app.o"
cxx -std=c++20 -fno-exceptions -fno-rtti -c "$vk/tooling/native/app_crt.cpp" -o "$obj/app_crt.o"
cxx -std=c++20 -fexceptions -fcxx-exceptions -c "$root/ps5/app/cpp_runtime.cpp" -o "$obj/app_cpp_runtime.o"

# The screen: ps5-opengl (EGL, OpenGL 4.6) is a Mesa of its own, and shares
# thousands of symbol names with RADV's. Linked into one object with only the
# GL and EGL API left global, the two never meet. Rebuilt when the SDK changes.
gl="$out/gl/gl_api.o"
if [ ! -f "$gl" ] || [ "$glsdk/lib/libPS5OpenGL.a" -nt "$gl" ]; then
    mkdir -p "$out/gl"
    gllibs=()
    for l in $(sed -n '/GROUP (/,/)/p' "$glsdk/lib/libPS5OpenGL.a" | grep -oE 'lib[a-z0-9_.]+\.a'); do
        gllibs+=("$glsdk/lib/$l")
    done
    "$sdk/bin/llvm-nm" --defined-only -g "$glsdk/lib/libps5_opengl_core33.a" "$glsdk/lib/libglapi_bridge.a" \
        "$glsdk/lib/libglapi.a" 2>/dev/null | awk 'NF>=3 && $2 ~ /[TW]/ {print $3}' |
        grep -E '^(gl|egl)[A-Z]|^ps5_opengl' | sort -u > "$out/gl/api.txt"
    us=()
    while read -r name; do us+=(-u "$name"); done < "$out/gl/api.txt"
    "$sdk/bin/ld.lld" -r "${us[@]}" -u ps5_agc_gate2_run --start-group "${gllibs[@]}" --end-group \
        -o "$out/gl/gl_all.o"
    "$sdk/bin/llvm-objcopy" --keep-global-symbols="$out/gl/api.txt" "$out/gl/gl_all.o" "$gl"
    rm -f "$out/gl/gl_all.o" "$out/gl/libps5lm_gl.a"
    # In an archive, so --exclude-libs keeps the API local: SDK stub modules
    # define EGL names too, and lld would export ours to interpose them.
    "$sdk/bin/llvm-ar" rcs "$out/gl/libps5lm_gl.a" "$gl"
fi
# The dashboard: ps5-homebrew-ui's kit (gfx, ui, core, audio and its console
# platform layer, without its shell, designs or demo), drawn through ps5-opengl.
kit="$root/third_party/ps5-homebrew-ui"
kitflags=(-std=c++20 -O2 -ffunction-sections -fdata-sections -DGL_GLEXT_PROTOTYPES=1 -I "$kit/src" -I "$kit/third_party"
    -I "$glsdk/include" -I "$root/ps5/app")
mkdir -p "$obj/kit"
mapfile -t kit_sources < <(find "$kit/src/gfx" "$kit/src/ui" "$kit/src/core" "$kit/src/audio" "$kit/src/third_party" \
    "$kit/src/platform/ps5" -type f \( -name '*.cpp' -o -name '*.c' \) ! -name display_egl.cpp | sort)
kit_objects=()
kit_pending=()
jobs_limit=${CMAKE_BUILD_PARALLEL_LEVEL:-$(nproc)}
[[ $jobs_limit =~ ^[1-9][0-9]*$ ]] || { echo "build-app: invalid job limit" >&2; exit 2; }
for src in "${kit_sources[@]}"; do
    o="$obj/kit/$(echo "${src#"$kit/src/"}" | tr '/' '_').o"
    kit_objects+=("$o")
    [ -f "$o" ] && [ "$o" -nt "$src" ] && continue
    if [[ $src == *.c ]]; then
        "$root/ps5/app/ps5cc" -std=c11 -O2 -w -I "$kit/src" -c "$src" -o "$o" &
    else
        cxx "${kitflags[@]}" -w -c "$src" -o "$o" &
    fi
    # Retain each PID: bare wait can hide an already-finished compiler failure.
    kit_pending+=("$!")
    if (( ${#kit_pending[@]} >= jobs_limit )); then
        wait "${kit_pending[0]}"
        kit_pending=("${kit_pending[@]:1}")
    fi
done
for pid in "${kit_pending[@]}"; do wait "$pid"; done
rm -f "$obj/libps5lm_kit.a"
"$sdk/bin/llvm-ar" rcs "$obj/libps5lm_kit.a" "${kit_objects[@]}"
for src in display dashboard stats; do
    cxx -fexceptions -fcxx-exceptions "${kitflags[@]}" -c "$root/ps5/app/$src.cpp" -o "$obj/$src.o"
done

# AGC comes from system modules; these stubs only name the imports, every
# one either driver (the GL object, RADV) makes.
agc_imports=$("$sdk/bin/llvm-nm" -u "$gl" "$archive" 2>/dev/null | awk '{print $NF}' | grep -E '^sceAgc' | sort -u)
for lib in libSceAgc libSceAgcDriver; do
    stub_c="$out/stubs/$lib.c"
    : > "$stub_c"
    for name in $agc_imports; do
        case $lib:$name in
            libSceAgcDriver:sceAgcDriver*) echo "void $name(void) {}" >> "$stub_c" ;;
            libSceAgc:sceAgcDriver*) ;;
            libSceAgc:*) echo "void $name(void) {}" >> "$stub_c" ;;
        esac
    done
    "$root/ps5/app/ps5cc" -O2 -fPIC -c "$stub_c" -o "$obj/${lib}_stub.o"
    "$sdk/bin/prospero-lld" --shared -soname "$lib.prx" -o "$out/stubs/$lib.so" "$obj/${lib}_stub.o"
done

# shellcheck source=/dev/null
source "$vk/tools/radv-link.sh"
PS5_CLANG="$shim/clang" radv_link_recipe "$vk" "$sdk" "$archive" || exit 2
# The platform's getaddrinfo always fails; ps5/app/compat_app.c has a numeric one.
flags=()
for f in "${radv_link_flags[@]}"; do
    case $f in --defsym=getaddrinfo=*|--defsym=freeaddrinfo=*) ;; *) flags+=("$f") ;; esac
done
radv_link_flags=("${flags[@]}" --wrap=sceAgcInit)
mapfile -t libs < <(find "$out/llama" -name '*.a' | sort)
# ---- the image engine as one object, only its API global --------------------
# Two ggmls define the same names. scripts/fold-sd.sh folds sd.cpp's whole set
# into a single object whose only global symbols are its API and the thunks the
# linker makes for its TLS variables, exactly as ps5-opengl's Mesa is folded
# next to RADV's; llama.cpp's ggml keeps the global names.
bash "$root/scripts/prefix-sd.sh"
sdlibs=()
# ---- the audio engine: audio.cpp, a third ggml, ACX_ prefixed ---------------
# The libraries come from src/prefix-audio.sh, which runs on an audio.cpp cross
# build (that build needs its own configure flags, so it is not part of this
# script). No directory = the engine is simply not linked into this build.
audiolibs=()
if [ -d "$root/.deps/audio-acx" ]; then
    for a in "$root/.deps/audio-acx"/*.a; do
        [ -e "$a" ] && audiolibs+=("$a")
    done
    echo "build-app: audio engine: ${#audiolibs[@]} archive(s) from .deps/audio-acx"
else
    echo "build-app: audio engine: not linked (no .deps/audio-acx)"
fi

trxlibs=()
if [ -d "$root/.deps/trellis-trx" ]; then
    for a in "$root/.deps/trellis-trx"/*.a; do
        [ -e "$a" ] && trxlibs+=("$a")
    done
    echo "build-app: 3D engine: ${#trxlibs[@]} TRX_ archive(s)"
fi

# ---- trellis names Vulkan entry points directly ------------------------------
# RADV is linked in whole and there is no Vulkan loader on the platform, so the
# camel-case entry names the engine calls have no definition. Each becomes an
# alias of an implementation already in the image: Mesa's common one where the
# entry is generic, the driver's own where it is not. vkGetInstanceProcAddr and
# vkGetDeviceProcAddr already come from ps5/app/main.cpp.
vk_shims=()
for pair in \
    vkAllocateCommandBuffers=vk_common_AllocateCommandBuffers \
    vkAllocateDescriptorSets=radv_AllocateDescriptorSets \
    vkAllocateMemory=radv_AllocateMemory \
    vkBeginCommandBuffer=radv_BeginCommandBuffer \
    vkBindBufferMemory=vk_common_BindBufferMemory \
    vkBindImageMemory=vk_common_BindImageMemory \
    vkCmdBindDescriptorSets=vk_common_CmdBindDescriptorSets \
    vkCmdBindPipeline=vk_common_CmdBindPipeline \
    vkCmdCopyBufferToImage=vk_common_CmdCopyBufferToImage \
    vkCmdCopyImage=vk_common_CmdCopyImage \
    vkCmdCopyImageToBuffer=vk_common_CmdCopyImageToBuffer \
    vkCmdDispatch=vk_common_CmdDispatch \
    vkCmdFillBuffer=vk_common_CmdFillBuffer \
    vkCmdPipelineBarrier=vk_common_CmdPipelineBarrier \
    vkCmdPushConstants=vk_common_CmdPushConstants \
    vkCreateBuffer=radv_CreateBuffer \
    vkCreateCommandPool=vk_common_CreateCommandPool \
    vkCreateComputePipelines=vk_common_CreateComputePipelines \
    vkCreateDescriptorPool=radv_CreateDescriptorPool \
    vkCreateDescriptorSetLayout=radv_CreateDescriptorSetLayout \
    vkCreateDevice=radv_CreateDevice \
    vkCreateFence=vk_common_CreateFence \
    vkCreateImage=radv_CreateImage \
    vkCreateImageView=radv_CreateImageView \
    vkCreateInstance=radv_CreateInstance \
    vkCreatePipelineLayout=vk_common_CreatePipelineLayout \
    vkCreateSampler=radv_CreateSampler \
    vkCreateSemaphore=vk_common_CreateSemaphore \
    vkCreateShaderModule=vk_common_CreateShaderModule \
    vkDestroyBuffer=radv_DestroyBuffer \
    vkDestroyCommandPool=vk_common_DestroyCommandPool \
    vkDestroyDescriptorPool=radv_DestroyDescriptorPool \
    vkDestroyDescriptorSetLayout=vk_common_DestroyDescriptorSetLayout \
    vkDestroyDevice=radv_DestroyDevice \
    vkDestroyFence=vk_common_DestroyFence \
    vkDestroyImage=radv_DestroyImage \
    vkDestroyImageView=radv_DestroyImageView \
    vkDestroyInstance=radv_DestroyInstance \
    vkDestroyPipeline=vk_common_DestroyPipeline \
    vkDestroyPipelineLayout=vk_common_DestroyPipelineLayout \
    vkDestroySampler=radv_DestroySampler \
    vkDestroySemaphore=vk_common_DestroySemaphore \
    vkDestroyShaderModule=vk_common_DestroyShaderModule \
    vkEndCommandBuffer=radv_EndCommandBuffer \
    vkEnumerateDeviceExtensionProperties=vk_common_EnumerateDeviceExtensionProperties \
    vkEnumerateInstanceExtensionProperties=radv_EnumerateInstanceExtensionProperties \
    vkEnumeratePhysicalDevices=vk_common_EnumeratePhysicalDevices \
    vkFlushMappedMemoryRanges=radv_FlushMappedMemoryRanges \
    vkFreeCommandBuffers=vk_common_FreeCommandBuffers \
    vkFreeDescriptorSets=radv_FreeDescriptorSets \
    vkFreeMemory=radv_FreeMemory \
    vkGetBufferMemoryRequirements=vk_common_GetBufferMemoryRequirements \
    vkGetDeviceQueue=vk_common_GetDeviceQueue \
    vkGetImageMemoryRequirements=vk_common_GetImageMemoryRequirements \
    vkGetPhysicalDeviceMemoryProperties=vk_common_GetPhysicalDeviceMemoryProperties \
    vkGetPhysicalDeviceProperties=vk_common_GetPhysicalDeviceProperties \
    vkGetPhysicalDeviceProperties2=vk_common_GetPhysicalDeviceProperties2 \
    vkGetPhysicalDeviceQueueFamilyProperties=vk_common_GetPhysicalDeviceQueueFamilyProperties \
    vkInvalidateMappedMemoryRanges=radv_InvalidateMappedMemoryRanges \
    vkMapMemory=vk_common_MapMemory \
    vkQueueSubmit=vk_common_QueueSubmit \
    vkResetCommandBuffer=vk_common_ResetCommandBuffer \
    vkResetFences=vk_common_ResetFences \
    vkUnmapMemory=vk_common_UnmapMemory \
    vkUpdateDescriptorSets=radv_UpdateDescriptorSets \
    vkWaitForFences=vk_common_WaitForFences \
    ; do
    [ -n "$pair" ] && vk_shims+=("--defsym=$pair")
done
echo "build-app: 3D engine: ${#vk_shims[@]} Vulkan entry aliases"
while read -r rel; do sdlibs+=("$out/sd/$rel"); done < "$out/sd/archives.txt"
"$sdk/bin/prospero-lld" --error-limit=0 "${radv_linker_script[@]}" --eh-frame-hdr "${radv_link_flags[@]}" \
    --version-script "$vk/tooling/native/app-symbols.map" --exclude-libs=ALL \
    -e _start -o "$out/llvm-pie.elf" \
    "$obj/app_crt.o" "$obj/app_cpp_runtime.o" "$obj/tls_stub.o" "$obj/main.o" "$obj/display.o" "$obj/model_plan.o" "$obj/adaptive.o" "$obj/settings.o" "$obj/tts_server.o" "$obj/sd_server.o" "$obj/media_server.o" ${rifeobj[@]+"${rifeobj[@]}"} ${audio_obj[@]+"${audio_obj[@]}"} "$obj/fetch.o" "$obj/market.o" "$obj/activity.o" "$obj/sha256.o" "$obj/dashboard.o" "$obj/stats.o" \
    ${trellis_obj[@]+"${trellis_obj[@]}"} \
    --start-group "${libs[@]}" "${sdlibs[@]}" ${audiolibs[@]+"${audiolibs[@]}"} ${trxlibs[@]+"${trxlibs[@]}"} ${avlibs[@]+"${avlibs[@]}"} ${rifelibs[@]+"${rifelibs[@]}"} "$obj/libps5lm_kit.a" "$obj/libps5app_compat.a" "$out/gl/libps5lm_gl.a" --end-group \
    "$out/stubs/libSceAgc.so" "$out/stubs/libSceAgcDriver.so" \
    ${vk_shims[@]+"${vk_shims[@]}"} \
    "${radv_link_inputs[@]}" \
    --as-needed "$sdk"/target/lib/*.so
"$tool" link --in "$out/llvm-pie.elf" --out "$out/eboot.elf" \
    --stub-dir "$sdk/target/lib" --stub "$out/stubs/libSceAgc.so" \
    --stub "$out/stubs/libSceAgcDriver.so" --module-sdk 0x02000009 \
    --companion-sdk 0x08050001 --file-name eboot.elf

title_id=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["titleId"])' "$param")
app="$out/title/$title_id"
rm -rf -- "$app"
mkdir -p "$app/sce_sys" "$app/sce_module"
"$tool" self --sign --in "$out/eboot.elf" --out "$app/eboot.bin" --magic 0x1D3D154F
cp "$param" "$app/sce_sys/param.json"
# The home screen backgrounds (3840x2160 BC7 DDS) are made from source/background.png
# (scripts/render-artwork.sh renders it from the SVG) by PS5_Vulkan's asset tools,
# and only when it changes.
if [ ! -f "$sce_sys/pic0.dds" ] || [ "$sce_sys/source/background.png" -nt "$sce_sys/pic0.dds" ]; then
    mkdir -p "$out/assets"
    (cd "$vk" && bash tools/setup-asset-dependencies.sh > /dev/null &&
        bash tools/prepare-assets.sh --icon "$sce_sys/icon0.png" --background "$sce_sys/source/background.png" \
            --output-directory "$out/assets" > /dev/null)
    cp "$out/assets/pic0.dds" "$out/assets/pic1.dds" "$sce_sys/"
fi
cp "$sce_sys/icon0.png" "$sce_sys/pic0.dds" "$sce_sys/pic1.dds" "$app/sce_sys/"
cp "$vk/runtime/libc.prx" "$app/sce_module/libc.prx"
# The dashboard's fonts and interface sounds, with their licences.
mkdir -p "$app/assets/fonts" "$app/assets/audio"
# Manrope for the screen (scripts/bake-fonts.sh), the kit's DejaVu Sans Mono for logs and code.
cp "$root/ps5/app/assets/fonts/"manrope-* "$app/assets/fonts/"
cp "$root/third_party/ps5-homebrew-ui/assets/fonts/"{dejavu-sans-mono.huifont,DejaVu-LICENSE.txt} "$app/assets/fonts/"
# The interface sounds are PocketVibe's (ps5/app/assets/audio/sfx).
# shortcut: they take the kit's default set name (glass), so no kit change picks
# them; give them a set of their own if the kit ever lets an app add one.
mkdir -p "$app/assets/audio/sfx/glass"
cp "$root/ps5/app/assets/audio/sfx/"* "$app/assets/audio/sfx/glass/"
# ps5-exporter (Marice, GPL-3.0): a title may not read the temperature, fan or
# SoC power sensors, a payload may. The app sends it to elfldr when it is not
# running. Pinned by version and hash, downloaded once into .deps.
exporter="$root/.deps/ps5-exporter-0.2.0.elf"
exporter_sha=0d19f7a293eeb30178ba562a3712abfdc50f6b6ebbe180ceaad92dc557948ba8
if [ ! -f "$exporter" ]; then
    curl -sSfL -o "$exporter.part" https://github.com/Marice/ps5-exporter/releases/download/v0.2.0/ps5-exporter.elf
    mv "$exporter.part" "$exporter"
fi
echo "$exporter_sha  $exporter" | sha256sum -c --quiet || { echo "build-app: ps5-exporter hash mismatch" >&2; exit 1; }
mkdir -p "$app/payloads"
cp "$exporter" "$app/payloads/ps5-exporter.elf"
printf '%s\n' "ps5-exporter v0.2.0 by Marice, GPL-3.0-or-later: https://github.com/Marice/ps5-exporter" \
    "Source: https://github.com/Marice/ps5-exporter/tree/v0.2.0" > "$app/payloads/ps5-exporter-NOTICE.txt"
"$tool" self --inspect --file "$app/eboot.bin" > /dev/null
echo "build-app: $app ($(stat -c %s "$app/eboot.bin") bytes)"
