// SPDX-License-Identifier: GPL-3.0-or-later
// PS5MM's picture engine: stable-diffusion.cpp, on its own ggml and Vulkan
// backend, in the same process as the text and speech engines.
//
// Routes:
//   POST /sdapi/v1/txt2img         A1111  -> { images: [base64 png] }
//   POST /sdapi/v1/txt2vid         ours   -> AVI (MJPEG) on the wire
//   POST /v1/images/generations    OpenAI -> { data: [{b64_json}] }
//   GET  /health, /sdapi/v1/options
//
// The model loads on the first request, not at the start: Wan 2.2's three
// pieces are 10 GB and the text and speech engines are already holding theirs.
// One context, one model, one generation at a time.

#include "sd_server.hpp"

#include "stable-diffusion.h"
#include "ggml.h"

// The JPEG/PNG encoder's implementation lives here; nothing else in the link
// defines it (sd.cpp's examples do, and they are not built).
// Both static: llama.cpp's mtmd carries its own stb_image, and a second global
// copy of stbi_* is a duplicate symbol at link time. Static keeps these here.
#define STB_IMAGE_STATIC
#define STB_IMAGE_WRITE_STATIC
#define STB_IMAGE_IMPLEMENTATION
#define STB_IMAGE_WRITE_IMPLEMENTATION
#include "stb_image.h"
#include "stb_image_write.h"

#include "cpp-httplib/httplib.h"
#include "nlohmann/json.hpp"

#include <sys/stat.h>

#include <atomic>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <ctime>
#include <mutex>
#include <string>
#include <thread>
#include <vector>

namespace {

using json = nlohmann::json;

struct Engine {
    sd_ctx_t *      ctx     = nullptr;
    upscaler_ctx_t * upscaler = nullptr;   // ESRGAN-class, loaded on demand too
    bool            ready   = false;
    SdModels        models{};
    std::mutex      mu;   // one generation at a time, and guards both
    std::atomic<long> jobs{ 0 };
    std::string     out_dir;
};

Engine            g_e;
httplib::Server   g_svr;
std::thread       g_thread;
std::atomic<bool> g_stop{ false };

const char * b64chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

std::string base64(const unsigned char * p, size_t n) {
    std::string out;
    out.reserve(((n + 2) / 3) * 4);
    size_t i = 0;
    for (; i + 2 < n; i += 3) {
        const unsigned v = (unsigned) p[i] << 16 | (unsigned) p[i + 1] << 8 | p[i + 2];
        out.push_back(b64chars[(v >> 18) & 63]);
        out.push_back(b64chars[(v >> 12) & 63]);
        out.push_back(b64chars[(v >> 6) & 63]);
        out.push_back(b64chars[v & 63]);
    }
    if (i + 1 == n) {
        const unsigned v = (unsigned) p[i] << 16;
        out.push_back(b64chars[(v >> 18) & 63]);
        out.push_back(b64chars[(v >> 12) & 63]);
        out += "==";
    } else if (i + 2 == n) {
        const unsigned v = (unsigned) p[i] << 16 | (unsigned) p[i + 1] << 8;
        out.push_back(b64chars[(v >> 18) & 63]);
        out.push_back(b64chars[(v >> 12) & 63]);
        out.push_back(b64chars[(v >> 6) & 63]);
        out.push_back('=');
    }
    return out;
}

bool write_file(const std::string & path, const void * data, size_t n) {
    FILE * f = std::fopen(path.c_str(), "wb");
    if (f == nullptr) {
        return false;
    }
    const size_t w = std::fwrite(data, 1, n, f);
    std::fclose(f);
    return w == n;
}

// Loads the model if it is not in yet. Called with g_e.mu held.
bool ensure_ctx(std::string & err) {
    if (g_e.ctx != nullptr) {
        return true;
    }
    if (g_e.models.diffusion == nullptr || g_e.models.diffusion[0] == 0) {
        err = "no model is configured";
        return false;
    }
    std::printf("ps5mm-sd: loading %s\n", g_e.models.diffusion);
    std::fflush(nullptr);
    const int64_t t0 = (int64_t) ggml_time_ms();

    sd_ctx_params_t cp;
    sd_ctx_params_init(&cp);
    cp.diffusion_model_path = g_e.models.diffusion;
    cp.clip_l_path = (g_e.models.clip_l != nullptr && g_e.models.clip_l[0] != 0) ? g_e.models.clip_l : nullptr;
    cp.clip_g_path = (g_e.models.clip_g != nullptr && g_e.models.clip_g[0] != 0) ? g_e.models.clip_g : nullptr;
    cp.t5xxl_path  = (g_e.models.t5xxl != nullptr && g_e.models.t5xxl[0] != 0) ? g_e.models.t5xxl : nullptr;
    cp.vae_path    = (g_e.models.vae != nullptr && g_e.models.vae[0] != 0) ? g_e.models.vae : nullptr;
    cp.n_threads   = 4;
    cp.enable_mmap = true;
    cp.flash_attn  = true;


    g_e.ctx = new_sd_ctx(&cp);
    if (g_e.ctx == nullptr) {
        err = "could not load the model";
        std::printf("ps5mm-sd: could not load %s\n", g_e.models.diffusion);
        std::fflush(nullptr);
        return false;
    }
    g_e.ready = true;
    std::printf("ps5mm-sd: loaded in %lld ms\n", (long long) (ggml_time_ms() - t0));
    std::fflush(nullptr);
    return true;
}

struct Picture {
    std::string png;
    int         width  = 0;
    int         height = 0;
};

bool draw_image(const json & body, std::vector<Picture> & pics, std::string & err) {
    const std::string prompt = body.value("prompt", std::string());
    if (prompt.empty()) {
        err = "prompt is empty";
        return false;
    }
    if (!ensure_ctx(err)) {
        return false;
    }
    sd_img_gen_params_t gp;
    sd_img_gen_params_init(&gp);
    gp.prompt = prompt.c_str();
    const std::string negative = body.value("negative_prompt", std::string());
    gp.negative_prompt   = negative.empty() ? nullptr : negative.c_str();
    gp.width             = body.value("width", 1024);
    gp.height            = body.value("height", 1024);
    gp.seed              = body.value("seed", (int64_t) -1);
    gp.batch_count       = 1;
    gp.sample_params.sample_steps     = body.value("steps", 20);
    gp.sample_params.guidance.txt_cfg = body.value("cfg_scale", 5.0f);
    // Wan decodes a whole clip's latents at once; tiles keep that inside the pool.
    gp.vae_tiling_params.enabled        = true;
    gp.vae_tiling_params.tile_size_w    = 256;
    gp.vae_tiling_params.tile_size_h    = 256;
    gp.vae_tiling_params.target_overlap = 0.25f;
    sd_image_t * images   = nullptr;
    int          n_images = 0;
    const int64_t t0      = (int64_t) ggml_time_ms();
    if (!generate_image(g_e.ctx, &gp, &images, &n_images) || images == nullptr) {
        err = "generation failed";
        return false;
    }
    for (int i = 0; i < n_images; ++i) {
        const sd_image_t & im = images[i];
        if (im.data == nullptr || im.width == 0) {
            continue;
        }
        int             len = 0;
        unsigned char * png = stbi_write_png_to_mem(im.data, 0, (int) im.width, (int) im.height, (int) im.channel,
                                                    &len, nullptr);
        if (png == nullptr) {
            continue;
        }
        Picture pic;
        pic.png.assign((const char *) png, (size_t) len);
        pic.width  = (int) im.width;
        pic.height = (int) im.height;
        STBIW_FREE(png);
        char name[200];
        std::snprintf(name, sizeof name, "%s/txt2img-%ld-%d.png", g_e.out_dir.c_str(), g_e.jobs.load(), i);
        write_file(name, pic.png.data(), pic.png.size());
        pics.push_back(std::move(pic));
        free(im.data);
    }
    free(images);
    std::printf("ps5mm-sd: %zu picture(s) %dx%d in %lld ms\n", pics.size(), gp.width, gp.height,
                (long long) (ggml_time_ms() - t0));
    std::fflush(nullptr);
    if (pics.empty()) {
        err = "no picture came out";
        return false;
    }
    return true;
}

// ---- MJPEG AVI ---------------------------------------------------------------
void put32(std::vector<unsigned char> & b, uint32_t v) {
    b.push_back((unsigned char) (v & 255));
    b.push_back((unsigned char) ((v >> 8) & 255));
    b.push_back((unsigned char) ((v >> 16) & 255));
    b.push_back((unsigned char) ((v >> 24) & 255));
}
void put16(std::vector<unsigned char> & b, uint16_t v) {
    b.push_back((unsigned char) (v & 255));
    b.push_back((unsigned char) ((v >> 8) & 255));
}
void putcc(std::vector<unsigned char> & b, const char * s) {
    b.insert(b.end(), s, s + 4);
    b.push_back(0);   // fourcc is 4 bytes, nothing more
    b.pop_back();
}

struct JpegSink {
    std::vector<unsigned char> * out;
};

bool frame_jpeg(const sd_image_t & im, int quality, std::vector<unsigned char> & out) {
    out.clear();
    JpegSink sink{ &out };
    const auto cb = [](void * ctx, void * data, int size) {
        auto * s = static_cast<JpegSink *>(ctx);
        const unsigned char * p = static_cast<const unsigned char *>(data);
        s->out->insert(s->out->end(), p, p + size);
    };
    return stbi_write_jpg_to_func(cb, &sink, (int) im.width, (int) im.height, (int) im.channel, im.data, quality) != 0 &&
           !out.empty();
}

std::vector<unsigned char> mjpeg_avi(const std::vector<std::vector<unsigned char>> & frames, int width, int height,
                                     int fps) {
    std::vector<unsigned char> out;
    const int      n    = (int) frames.size();
    const uint32_t rate = (uint32_t) (fps > 0 ? fps : 16);

    uint32_t movi_payload = 4;   // "movi"
    for (const auto & f : frames) {
        movi_payload += 8 + (uint32_t) f.size() + ((f.size() & 1) ? 1u : 0u);
    }
    const uint32_t idx_payload  = 16u * (uint32_t) n;
    const uint32_t hdrl_payload = 4 + (8 + 56) + (4 + (8 + 56) + (8 + 40));
    const uint32_t riff_payload = 4 + (8 + hdrl_payload) + (8 + movi_payload) + (8 + idx_payload);

    putcc(out, "RIFF");
    put32(out, riff_payload);
    putcc(out, "AVI ");

    putcc(out, "LIST");
    put32(out, hdrl_payload);
    putcc(out, "hdrl");

    putcc(out, "avih");
    put32(out, 56);
    put32(out, 1000000u / rate);
    put32(out, (uint32_t) ((uint64_t) n * 1000000u / rate));
    put32(out, 0);
    put32(out, 0x00000110);   // AVIF_HASINDEX | AVIF_ISINTERLEAVED
    put32(out, (uint32_t) n);
    put32(out, 0);
    put32(out, 1);
    put32(out, frames.empty() ? 0u : (uint32_t) frames[0].size());
    put32(out, (uint32_t) width);
    put32(out, (uint32_t) height);
    for (int i = 0; i < 4; ++i) put32(out, 0);

    putcc(out, "LIST");
    put32(out, 4 + (8 + 56) + (8 + 40));
    putcc(out, "strl");

    putcc(out, "strh");
    put32(out, 56);
    putcc(out, "vids");
    putcc(out, "MJPG");
    put32(out, 0);
    put16(out, 0);
    put16(out, 0);
    put32(out, 0);
    put32(out, 1);
    put32(out, rate);
    put32(out, 0);
    put32(out, (uint32_t) n);
    put32(out, (uint32_t) ((uint64_t) n * 1000000u / rate));
    put32(out, 0);
    put32(out, 0xFFFFFFFF);
    put32(out, 0);
    put16(out, 0); put16(out, 0); put16(out, 0); put16(out, 0);

    putcc(out, "strf");
    put32(out, 40);
    put32(out, 40);
    put32(out, (uint32_t) width);
    put32(out, (uint32_t) height);
    put16(out, 1);
    put16(out, 24);
    putcc(out, "MJPG");
    put32(out, (uint32_t) (width * height * 3));
    put32(out, 0); put32(out, 0); put32(out, 0); put32(out, 0);

    putcc(out, "LIST");
    put32(out, movi_payload);
    putcc(out, "movi");
    std::vector<uint32_t> offsets;
    offsets.reserve((size_t) n);
    for (const auto & f : frames) {
        // Offsets in idx1 count from the "movi" fourcc (4 + 4 + 4 + 4 before it).
        offsets.push_back((uint32_t) (out.size() - (4 + 4 + 4 + 4)));
        putcc(out, "00dc");
        put32(out, (uint32_t) f.size());
        out.insert(out.end(), f.begin(), f.end());
        if (f.size() & 1) {
            out.push_back(0);
        }
    }

    putcc(out, "idx1");
    put32(out, idx_payload);
    for (int i = 0; i < n; ++i) {
        putcc(out, "00dc");
        put32(out, 0x00000010);
        put32(out, offsets[(size_t) i]);
        put32(out, (uint32_t) frames[(size_t) i].size());
    }
    return out;
}

bool make_video(const json & body, std::vector<unsigned char> & avi, std::string & err) {
    const std::string prompt = body.value("prompt", std::string());
    if (prompt.empty()) {
        err = "prompt is empty";
        return false;
    }
    if (!ensure_ctx(err)) {
        return false;
    }
    sd_vid_gen_params_t gp;
    sd_vid_gen_params_init(&gp);
    gp.prompt = prompt.c_str();
    const std::string negative = body.value("negative_prompt", std::string());
    gp.negative_prompt   = negative.empty() ? nullptr : negative.c_str();
    gp.width             = body.value("width", 832);
    gp.height            = body.value("height", 480);
    gp.video_frames      = body.value("frames", 33);
    gp.fps               = body.value("fps", 16);
    gp.seed              = body.value("seed", (int64_t) -1);
    gp.sample_params.sample_steps     = body.value("steps", 20);
    gp.sample_params.guidance.txt_cfg = body.value("cfg_scale", 5.0f);
    // Wan decodes a whole clip's latents at once; tiles keep that inside the pool.
    gp.vae_tiling_params.enabled        = true;
    gp.vae_tiling_params.tile_size_w    = 256;
    gp.vae_tiling_params.tile_size_h    = 256;
    gp.vae_tiling_params.target_overlap = 0.25f;
    sd_image_t * frames = nullptr;
    int          count  = 0;
    sd_audio_t * audio  = nullptr;
    int          fps    = gp.fps;
    const int64_t t0    = (int64_t) ggml_time_ms();
    if (!generate_video(g_e.ctx, &gp, &frames, &count, &audio, &fps) || frames == nullptr || count <= 0) {
        err = "generation failed";
        return false;
    }

    std::vector<std::vector<unsigned char>> jpegs;
    jpegs.reserve((size_t) count);
    for (int i = 0; i < count; ++i) {
        std::vector<unsigned char> j;
        if (frame_jpeg(frames[i], 90, j)) {
            jpegs.push_back(std::move(j));
        }
        if (frames[i].data != nullptr) {
            free(frames[i].data);
        }
    }
    free(frames);
    if (audio != nullptr) {
        if (audio->data != nullptr) {
            free(audio->data);
        }
        free(audio);
    }
    if (jpegs.empty()) {
        err = "no frame came out";
        return false;
    }
    avi = mjpeg_avi(jpegs, gp.width, gp.height, fps > 0 ? fps : gp.fps);
    char name[200];
    std::snprintf(name, sizeof name, "%s/txt2vid-%ld.avi", g_e.out_dir.c_str(), g_e.jobs.load());
    write_file(name, avi.data(), avi.size());
    std::printf("ps5mm-sd: %zu frame(s) %dx%d @%d fps in %lld ms -> %s\n", jpegs.size(), gp.width, gp.height,
                fps > 0 ? fps : gp.fps, (long long) (ggml_time_ms() - t0), name);
    std::fflush(nullptr);
    return true;
}

// ---- routes -------------------------------------------------------------------
void send_error(httplib::Response & res, int code, const std::string & msg) {
    res.status = code;
    res.set_content(json{ { "error", msg } }.dump(), "application/json");
}

json parse_body(const httplib::Request & req, httplib::Response & res) {
    json body = json::parse(req.body, nullptr, false);
    if (body.is_discarded() || !body.is_object()) {
        send_error(res, 400, "the body is not a JSON object");
        return json();
    }
    return body;
}

void on_txt2img(const httplib::Request & req, httplib::Response & res) {
    const json body = parse_body(req, res);
    if (body.is_null()) {
        return;
    }
    std::lock_guard<std::mutex> lock(g_e.mu);
    g_e.jobs++;
    std::vector<Picture> pics;
    std::string          err;
    if (!draw_image(body, pics, err)) {
        send_error(res, 500, err);
        return;
    }
    json images = json::array();
    for (const auto & p : pics) {
        images.push_back(base64((const unsigned char *) p.png.data(), p.png.size()));
    }
    res.set_content(json{ { "images", images }, { "info", g_e.models.diffusion } }.dump(), "application/json");
}

void on_txt2vid(const httplib::Request & req, httplib::Response & res) {
    const json body = parse_body(req, res);
    if (body.is_null()) {
        return;
    }
    std::lock_guard<std::mutex> lock(g_e.mu);
    g_e.jobs++;
    std::vector<unsigned char> avi;
    std::string                err;
    if (!make_video(body, avi, err)) {
        send_error(res, 500, err);
        return;
    }
    res.set_content(std::string((const char *) avi.data(), avi.size()), "video/x-msvideo");
}

void on_openai_images(const httplib::Request & req, httplib::Response & res) {
    const json body = parse_body(req, res);
    if (body.is_null()) {
        return;
    }
    const std::string size = body.value("size", std::string("1024x1024"));
    json shaped        = body;
    if (const size_t x = size.find('x'); x != std::string::npos) {
        shaped["width"]  = std::atoi(size.substr(0, x).c_str());
        shaped["height"] = std::atoi(size.substr(x + 1).c_str());
    }
    std::lock_guard<std::mutex> lock(g_e.mu);
    g_e.jobs++;
    std::vector<Picture> pics;
    std::string          err;
    if (!draw_image(shaped, pics, err)) {
        send_error(res, 500, err);
        return;
    }
    json data = json::array();
    for (const auto & p : pics) {
        data.push_back(json{ { "b64_json", base64((const unsigned char *) p.png.data(), p.png.size()) } });
    }
    res.set_content(json{ { "created", (long long) std::time(nullptr) }, { "data", data } }.dump(), "application/json");
}

// Upscales one picture with the ESRGAN model the settings name, on demand:
// the model is small next to the rest, but there is no point holding it from
// the start either.
bool upscale_one(const std::string & in_path, int out_scale, std::string & out_png, std::string & err) {
    if (g_e.models.esrgan == nullptr || g_e.models.esrgan[0] == 0) {
        err = "no upscaler model is configured";
        return false;
    }
    if (g_e.upscaler == nullptr) {
        std::printf("ps5mm-sd: loading upscaler %s\n", g_e.models.esrgan);
        std::fflush(nullptr);
        g_e.upscaler = new_upscaler_ctx(g_e.models.esrgan, false, 4, 256, nullptr, nullptr);
        if (g_e.upscaler == nullptr) {
            err = "could not load the upscaler model";
            return false;
        }
    }
    int w = 0, h = 0, comp = 0;
    unsigned char * pixels = stbi_load(in_path.c_str(), &w, &h, &comp, 3);
    if (pixels == nullptr) {
        err = "could not read that picture";
        return false;
    }
    sd_image_t in{ (uint32_t) w, (uint32_t) h, 3, pixels };
    sd_image_t * outs = nullptr;
    int          n_out = 0;
    const uint32_t factor = (uint32_t) (out_scale > 0 ? out_scale : get_upscale_factor(g_e.upscaler));
    const bool ok = upscale(g_e.upscaler, in, factor, &outs, &n_out);
    stbi_image_free(pixels);
    if (!ok || outs == nullptr || n_out <= 0) {
        err = "upscaling failed";
        return false;
    }
    const sd_image_t out = outs[0];
    int             len = 0;
    unsigned char * png = stbi_write_png_to_mem(out.data, 0, (int) out.width, (int) out.height, (int) out.channel,
                                                &len, nullptr);
    free(out.data);
    free(outs);
    if (png == nullptr) {
        err = "could not encode the result";
        return false;
    }
    out_png.assign((const char *) png, (size_t) len);
    STBIW_FREE(png);
    return true;
}

void on_upscale(const httplib::Request & req, httplib::Response & res) {
    const json body = parse_body(req, res);
    if (body.is_null()) {
        return;
    }
    // A1111's extra-single-image takes image as base64; ours also takes a path.
    std::string path = body.value("image_path", std::string());
    if (path.empty()) {
        const std::string b64 = body.value("image", std::string());
        if (b64.empty()) {
            send_error(res, 400, "give image_path or image (base64 png)");
            return;
        }
        // base64 -> file, in the outputs folder
        std::string raw;
        raw.reserve(b64.size() * 3 / 4 + 3);
        unsigned acc = 0;
        int      bits = 0;
        for (char c : b64) {
            int v = -1;
            if (c >= 'A' && c <= 'Z') v = c - 'A';
            else if (c >= 'a' && c <= 'z') v = c - 'a' + 26;
            else if (c >= '0' && c <= '9') v = c - '0' + 52;
            else if (c == '+') v = 62;
            else if (c == '/') v = 63;
            else continue;   // '=' and whitespace
            acc = (acc << 6) | (unsigned) v;
            bits += 6;
            if (bits >= 8) {
                bits -= 8;
                raw.push_back((char) ((acc >> bits) & 0xFF));
            }
        }
        char name[200];
        std::snprintf(name, sizeof name, "%s/upscale-in-%ld.png", g_e.out_dir.c_str(), g_e.jobs.load());
        if (!write_file(name, raw.data(), raw.size())) {
            send_error(res, 500, "could not stage the picture");
            return;
        }
        path = name;
    }
    std::lock_guard<std::mutex> lock(g_e.mu);
    g_e.jobs++;
    std::string png;
    std::string err;
    if (!upscale_one(path, body.value("scale", 4), png, err)) {
        send_error(res, 500, err);
        return;
    }
    char name[200];
    std::snprintf(name, sizeof name, "%s/upscaled-%ld.png", g_e.out_dir.c_str(), g_e.jobs.load());
    write_file(name, png.data(), png.size());
    res.set_content(json{ { "image", base64((const unsigned char *) png.data(), png.size()) }, { "saved", name } }.dump(),
                    "application/json");
}

void on_health(const httplib::Request &, httplib::Response & res) {
    json out{ { "ok", true },
              { "engine", "picture" },
              { "model_loaded", g_e.ready },
              { "jobs", (long) g_e.jobs.load() },
              { "model", g_e.models.diffusion != nullptr ? g_e.models.diffusion : "" } };
    res.set_content(out.dump(), "application/json");
}

void on_options(const httplib::Request &, httplib::Response & res) {
    res.set_content(json{ { "sd_model_checkpoint", g_e.models.diffusion != nullptr ? g_e.models.diffusion : "" } }.dump(),
                    "application/json");
}

}  // namespace

int sd_server_start(const SdModels & models, int port) {
    g_e.models       = models;
    g_e.out_dir      = models.output_dir != nullptr ? models.output_dir : "/data/PS5MM/outputs";
    mkdir(g_e.out_dir.c_str(), 0777);
    std::printf("ps5mm-sd: routes on :%d, model %s (loads on first request), writes %s\n", port,
                models.diffusion != nullptr ? models.diffusion : "(none)", g_e.out_dir.c_str());
    std::fflush(nullptr);

    g_svr.Get("/health", on_health);
    g_svr.Get("/sdapi/v1/options", on_options);
    g_svr.Post("/sdapi/v1/txt2img", on_txt2img);
    g_svr.Post("/sdapi/v1/txt2vid", on_txt2vid);
    g_svr.Post("/v1/images/generations", on_openai_images);
    g_svr.Post("/sdapi/v1/upscale", on_upscale);
    g_svr.set_read_timeout(120, 0);
    g_svr.set_write_timeout(3600, 0);   // a 33-frame 832x480 clip is minutes
    g_svr.set_payload_max_length(4 * 1024 * 1024);

    g_thread = std::thread([port] {
        if (!g_svr.listen("0.0.0.0", port)) {
            std::printf("ps5mm-sd: could not listen on %d\n", port);
            std::fflush(nullptr);
        }
        std::printf("ps5mm-sd: the listener stopped\n");
        std::fflush(nullptr);
    });
    return 0;
}

void sd_server_terminate(void) {
    if (g_stop.exchange(true)) {
        return;
    }
    g_svr.stop();
    if (g_thread.joinable()) {
        g_thread.join();
    }
    if (g_e.ctx != nullptr) {
        free_sd_ctx(g_e.ctx);
        g_e.ctx = nullptr;
    }
}

bool sd_server_ready(void) {
    return g_e.ready;
}

bool sd_server_listening(void) {
    return !g_stop.load();
}

std::string sd_server_state(void) {
    char buf[512];
    std::snprintf(buf, sizeof buf, "model=%s loaded=%d jobs=%ld", g_e.models.diffusion != nullptr ? g_e.models.diffusion : "-",
                  g_e.ready ? 1 : 0, g_e.jobs.load());
    return std::string(buf);
}
