int sd_server_start(const SdModels & models, int port) {
    g_e.take_models(models);   // 抄一份自己的，别留调用方的裸指针
    g_e.out_dir      = g_e.models.output_dir != nullptr ? g_e.models.output_dir : "/data/PS5MM/outputs";
    mkdir(g_e.out_dir.c_str(), 0777);
    std::printf("ps5mm-sd: routes on :%d, model %s (loads on first request), writes %s\n", port,
                g_e.models.diffusion != nullptr ? g_e.models.diffusion : "(none)", g_e.out_dir.c_str());
    std::fflush(nullptr);

    g_svr.Get("/health", on_health);
    g_svr.Get("/sdapi/v1/options", on_options);
    g_svr.Post("/sdapi/v1/txt2img", on_txt2img);
    g_svr.Post("/sdapi/v1/txt2vid", on_txt2vid);
    g_svr.Post("/v1/images/generations", on_openai_images);
    g_svr.Post("/sdapi/v1/upscale", on_upscale);
    g_svr.Post("/sdapi/v1/img2img", on_img2img);
    g_svr.Post("/sdapi/v1/inpaint", on_inpaint);
    // FFmpeg routes ride along: media is plumbing, not an engine
    // that deserves a slot of its own.
    ps5mm::media_register_routes(g_svr);
    // Frame interpolation rides along too: RIFE holds no resident model.
    ps5mm::interp_register_routes(g_svr, "/data/PS5MM/rife");
    g_svr.set_read_timeout(120, 0);
    g_svr.set_write_timeout(3600, 0);   // a 33-frame 832x480 clip is minutes
    g_svr.set_payload_max_length(4 * 1024 * 1024);
    sd_set_progress_callback(on_progress, nullptr);

    g_thread = std::thread([port] {
        if (!g_svr.listen("0.0.0.0", port)) {
            std::printf("ps5mm-sd: could not listen on %d\n", port);
            std::fflush(nullptr);
        }
        std::printf("ps5mm-sd: the listener stopped\n");
        std::fflush(nullptr);
        g_worker_done.store(true);   // 只有真正退出 listen 才会走到这里
    });
    return 0;
}

void sd_server_terminate(void) {
    if (g_stop.exchange(true)) {
        return;
    }
    g_svr.stop();
    if (!g_thread.joinable()) {
        return;
    }
    // 线程可能正卡在 new_sd_ctx()（Vulkan 分配 / safetensors 解析）里，
    // 永远回不到 listen 循环 —— 那样 join() 会把整个退出流程拖死：
    //     Options 两次 → 弹提示（主循环活着）→ 再按 → 卡在"正在退出"
    //     8002 掉了、8001/8004/8005 还在 = 根本没走到 LoadExec
    //     app.log 里从来没有 "ps5mm-sd: the listener stopped"
    // llama 那条 models.stop() 早就用「限时等，等不到就放弃」兜住了，照抄。
    bool finished = g_worker_done.load();
    for (int i = 0; i < 30 && !finished; ++i) {
        usleep(100 * 1000);
        finished = g_worker_done.load();
    }
    if (finished) {
        g_thread.join();
        if (g_e.ctx != nullptr) {
            free_sd_ctx(g_e.ctx);
            g_e.ctx = nullptr;
        }
    } else {
        std::printf("ps5mm-sd: worker stuck in a load; detaching so exit cannot hang\n");
        std::fflush(nullptr);
        g_thread.detach();   // 不 free ctx：那个线程可能还在用它，而进程马上要退
    }
}

// 启动时就加载（设置里勾了「启动加载」才调）。失败不致命：路由还在，第一次请求会再试。
int sd_server_preload(void) {
    std::lock_guard<std::mutex> lock(g_e.mu);
    if (g_e.ctx != nullptr) {
        return 0;
    }
    std::string err;
    if (!ensure_ctx(err)) {
        std::printf("ps5mm-sd: preload failed: %s\n", err.c_str());
        std::fflush(nullptr);
        return -1;
    }
    std::printf("ps5mm-sd: preloaded at boot\n");
    std::fflush(nullptr);
    return 0;
}

void sd_server_progress(int * step, int * steps) {
    if (step != nullptr) {
        *step = g_e.step.load();
    }
    if (steps != nullptr) {
        *steps = g_e.steps.load();
    }
}

bool sd_server_ready(void) {
    return g_e.ready;
}

bool sd_server_listening(void) {
    return !g_stop.load();
}

std::string sd_server_state(void) {
    char buf[512];
    std::snprintf(buf, sizeof buf, "model=%s loaded=%d jobs=%ld step=%d/%d", g_e.models.diffusion != nullptr ? g_e.models.diffusion : "-",
                  g_e.ready ? 1 : 0, g_e.jobs.load(), g_e.step.load(), g_e.steps.load());
    return std::string(buf);
}
