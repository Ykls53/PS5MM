struct Engine {
    sd_ctx_t *      ctx     = nullptr;
    upscaler_ctx_t * upscaler = nullptr;   // ESRGAN-class, loaded on demand too
    bool            ready   = false;
    SdModels        models{};
    // SdModels 里是 const char *：指向调用方那份 Settings（界面上传进来的副本），
    // 它在 sd_server_start 返回后就没了，而模型要到第一次请求才加载。所以这里自己
    // 留一份字符串，让 models 里的指针只指向自己这份，绝不指向调用方的栈。
    std::string     own[7];
    void take_models(const SdModels & in) {
        const char * src[7] = { in.diffusion, in.clip_l, in.clip_g, in.t5xxl, in.vae, in.esrgan, in.output_dir };
        for (int i = 0; i < 7; ++i) {
            own[i] = src[i] != nullptr ? src[i] : "";
        }
        models.diffusion  = src[0] != nullptr ? own[0].c_str() : nullptr;
        models.clip_l     = src[1] != nullptr ? own[1].c_str() : nullptr;
        models.clip_g     = src[2] != nullptr ? own[2].c_str() : nullptr;
        models.t5xxl      = src[3] != nullptr ? own[3].c_str() : nullptr;
        models.vae        = src[4] != nullptr ? own[4].c_str() : nullptr;
        models.esrgan     = src[5] != nullptr ? own[5].c_str() : nullptr;
        models.output_dir = src[6] != nullptr ? own[6].c_str() : nullptr;
    }
    std::mutex      mu;   // one generation at a time, and guards both
    std::atomic<long> jobs{ 0 };
    std::string     out_dir;
    // 进度：sd.cpp 每走一步都回调一次，界面靠它显示「第 12 / 20 步」
    std::atomic<int>  step{ 0 };
    std::atomic<int>  steps{ 0 };
    std::atomic<int>  out_w{ 0 }, out_h{ 0 };   // 上一张成品的尺寸
};

