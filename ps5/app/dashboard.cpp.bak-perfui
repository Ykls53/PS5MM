namespace {

// ---- the design language -------------------------------------------------------
//
// PS5MM 的第一原则：色彩只属于模态。界面骨架（背景、面板、焦点、文字）全是
// 石墨和暖白，彩色只出现在引擎自己身上 —— 五个槽位的模态色。焦点用暖白，
// 不用蓝色：颜色是五个引擎席位的身份，不是装饰。

const Color kBase    = Color::rgb(0x0e0e11);  // 暖石墨，微紫底调
const Color kSurface = Color::rgb(0x17171c);  // sheets and panels
const Color kRaised  = Color::rgb(0x1f1f26);  // the focused row
const Color kHair    = Color::rgb(0x2a2a33);  // dividers
const Color kInk     = Color::rgb(0xf2f1ec);  // 暖白
const Color kInk2    = Color::rgb(0xa7a6a0);
const Color kInk3    = Color::rgb(0x6a6a66);
const Color kAccent  = Color::rgb(0xf2f1ec);  // 焦点与选中：暖白，不带色相
const Color kRed     = Color::rgb(0xe05555);  // 失败
const Color kAmber   = Color::rgb(0xd9a441);  // 警告、进行中
const Color kBlack   = Color::rgb(0x000000);

// 模态光谱：五个引擎席位各自的身份色。
const Color kModText    = Color::rgb(0x5b7cff);  // 文字：靛蓝
const Color kModPicture = Color::rgb(0xa78bfa);  // 图像：紫
const Color kModSpeech  = Color::rgb(0x2dd4bf);  // 语音：青
const Color kModVideo   = Color::rgb(0xe4539e);  // 视频：品红

// 槽位的模态色；预留和未知归灰。
Color mod_color(const std::string & kind) {
    return kind == "text"    ? kModText
         : kind == "picture" ? kModPicture
         : kind == "speech"  ? kModSpeech
         : kind == "video"   ? kModVideo
                             : kInk3;
}

// 五笔频谱标：PS5MM 的品牌符号。五条竖笔按 高-低-高-低-高 排成 "M"，
// 每笔是一个引擎槽位 —— 活着的引擎亮自己的模态色，闲的是石墨灰。
// 品牌标志即集群实时状态。alive < 0 时用 engines 的真实状态；
// clock >= 0 时笔高带呼吸（busy 屏用）。
void draw_mark(gfx::DrawList & l, float x, float y, float h, const Live & live, float clock = -1.0f) {
    static const float share[5] = { 1.0f, 0.52f, 0.82f, 0.52f, 1.0f };
    const float w = std::max(2.0f, h * 0.14f), gap = h * 0.16f;
    for (int i = 0; i < 5; ++i) {
        Color c = kInk3;
        bool  lit = false;
        if (i < (int) live.engines.size()) {
            const EngineCard & e = live.engines[(size_t) i];  // engines 按槽位 1..5 顺序
            lit = !e.reserved && e.state != "未配置" && e.state != "未启动";
            if (lit) {
                c = mod_color(e.kind);
            }
        }
        float bh = h * share[i];
        if (clock >= 0.0f) {
            bh *= 0.82f + 0.18f * std::sin(clock * 2.2f + (float) i * 0.9f);
            if (!lit) {
                c = gfx::mix(kInk3, kInk, 0.35f + 0.3f * std::sin(clock * 2.2f + (float) i * 0.9f));
            }
        }
        l.rounded_rect({ x + (w + gap) * (float) i, y + (h - bh), w, bh }, w * 0.5f, c);
    }
}

