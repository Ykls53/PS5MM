// ---- small helpers ----------------------------------------------------------------

float put(gfx::DrawList & l, const ui::FontRef & f, std::string_view v, float x, float y, float size, Color c,
           gfx::Align a = gfx::Align::left) {
    return ui::text(l, f, v, x, y, size, c, a);
}

std::string format(const char * fmt, double v) {
    char t[48];
    std::snprintf(t, sizeof(t), fmt, v);
    return t;
}

// "9,120"
std::string thousands(uint64_t v) {
    std::string s = std::to_string(v);
    for (int i = (int) s.size() - 3; i > 0; i -= 3) {
        s.insert((size_t) i, ",");
    }
    return s;
}

// Sizes as the console's own screens give them: binary gigabytes, called GB.
std::string gb(double gib) { return format("%.1f GB", gib); }
std::string gb_text(std::string s) {
    for (size_t at = s.find("GiB"); at != std::string::npos; at = s.find("GiB", at)) {
        s.replace(at, 3, "GB");
    }
    return s;
}

// "Qwen3.8-27B-UD-IQ2_XXS" -> "Qwen3.8 27B" and "UD-IQ2_XXS": the build starts
// at the first part that names a quantization.
bool quant_part(const std::string & p) {
    std::string u = p;
    std::transform(u.begin(), u.end(), u.begin(), [](unsigned char c) { return (char) std::toupper(c); });
    const auto starts = [&](const char * s) { return u.rfind(s, 0) == 0; };
    return u == "UD" || u == "BF16" || u == "F16" || u == "F32" || starts("MXFP") || u.find("_K") != std::string::npos ||
           (u.size() > 1 && (u[0] == 'Q' || starts("IQ") || starts("TQ") || starts("PQ")) &&
            std::isdigit((unsigned char) u[u[0] == 'Q' ? 1 : 2]));
}

void split_name(const std::string & label, std::string * name, std::string * build) {
    std::vector<std::string> parts;
    size_t at = 0;
    while (at <= label.size()) {
        const size_t dash = label.find('-', at);
        parts.push_back(label.substr(at, dash == std::string::npos ? std::string::npos : dash - at));
        if (dash == std::string::npos) {
            break;
        }
        at = dash + 1;
    }
    name->clear();
    build->clear();
    bool in_build = false;
    for (const auto & p : parts) {
        in_build = in_build || quant_part(p);
        std::string & to = in_build ? *build : *name;
        if (!in_build && (p == "it" || p == "Instruct" || p == "GGUF")) {
            continue;
        }
        to += (to.empty() ? "" : in_build ? "-" : " ") + p;
    }
    if (name->empty()) {
        *name = label;
    }
}

// A slim bar: the track, and the share filled.
void meter(gfx::DrawList & l, float x, float y, float w, float share, Color c) {
    l.rounded_rect({ x, y, w, 4 }, 2, kHair);
    if (share > 0.002f) {
        l.rounded_rect({ x, y, std::max(4.0f, w * tween::clamp01(share)), 4 }, 2, c);
    }
}

// The model's speed over the last two minutes as one line, newest on the
// right, on a faint floor; Tesla's energy graph, not a dashboard chart.
// A series of up to 120 points between lo and hi, newest at the right edge.
void plot(gfx::DrawList & l, const std::vector<float> & v, const Rect & g, Color c, float lo, float hi) {
    if (v.size() < 2 || hi <= lo) {
        return;
    }
    const float step = g.w / 119.0f;
    const auto at = [&](float x) { return g.y + g.h - tween::clamp01((x - lo) / (hi - lo)) * g.h; };
    float lx = 0, ly = 0;
    for (size_t age = 0; age < v.size(); ++age) {
        const float x = g.x + g.w - (float) age * step;
        const float y = at(v[v.size() - 1 - age]);
        if (age > 0) {
            l.line(lx, ly, x, y, 2.0f, c);
        }
        lx = x;
        ly = y;
    }
    l.circle(g.x + g.w, at(v.back()), 5, c);
}

void trace(gfx::DrawList & l, const std::vector<float> & v, const Rect & g, Color c) {
    l.line(g.x, g.y + g.h, g.x + g.w, g.y + g.h, 1.5f, kHair);
    float top = 1.0f;
    for (float x : v) {
        top = std::max(top, x);
    }
    plot(l, v, g, c, 0, top * 1.15f);
}

// The dock's line icons, 32 px, drawn with strokes like the rest.
void icon(gfx::DrawList & l, int page, float cx, float cy, Color c) {
    const float w = 2.6f;
    switch (page) {
        case Dashboard::kHomePage:
            l.line(cx - 16, cy - 1, cx, cy - 14, w, c);
            l.line(cx, cy - 14, cx + 16, cy - 1, w, c);
            l.line(cx - 11, cy - 5, cx - 11, cy + 13, w, c);
            l.line(cx + 11, cy - 5, cx + 11, cy + 13, w, c);
            l.line(cx - 11, cy + 13, cx + 11, cy + 13, w, c);
            l.line(cx - 3, cy + 13, cx - 3, cy + 4, w, c);
            l.line(cx + 3, cy + 13, cx + 3, cy + 4, w, c);
            l.line(cx - 3, cy + 4, cx + 3, cy + 4, w, c);
            break;
        case Dashboard::kModelsPage: {
            // A cube: the hexagon and the three edges that meet in front.
            const float r = 15, h = 13;
            const float px[] = { cx, cx + h, cx + h, cx, cx - h, cx - h };
            const float py[] = { cy - r, cy - r / 2, cy + r / 2, cy + r, cy + r / 2, cy - r / 2 };
            for (int i = 0; i < 6; ++i) {
                l.line(px[i], py[i], px[(i + 1) % 6], py[(i + 1) % 6], w, c);
            }
            l.line(cx, cy, cx - h, cy - r / 2, w, c);
            l.line(cx, cy, cx + h, cy - r / 2, w, c);
            l.line(cx, cy, cx, cy + r, w, c);
            break;
        }
        case Dashboard::kApiPage:
            l.line(cx - 7, cy - 10, cx - 16, cy, w, c);
            l.line(cx - 16, cy, cx - 7, cy + 10, w, c);
            l.line(cx + 7, cy - 10, cx + 16, cy, w, c);
            l.line(cx + 16, cy, cx + 7, cy + 10, w, c);
            l.line(cx + 3, cy - 13, cx - 3, cy + 13, w, c);
            break;
        case Dashboard::kConsolePage: {
            // A pulse: the line a monitor draws.
            const float px[] = { cx - 17, cx - 8, cx - 3, cx + 3, cx + 8, cx + 17 };
            const float py[] = { cy + 2, cy + 2, cy - 12, cy + 13, cy, cy };
            for (int i = 0; i < 5; ++i) {
                l.line(px[i], py[i], px[i + 1], py[i + 1], w, c);
            }
            break;
        }
        default: {
            const float knobs[] = { -6, 7, -1 };
            for (int i = 0; i < 3; ++i) {
                const float y = cy - 10 + 10.0f * (float) i;
                l.line(cx - 16, y, cx + 16, y, w, c);
                l.circle(cx + knobs[i], y, 5.5f, kBase);
                l.ring(cx + knobs[i], y, 5.0f, w, c);
            }
            break;
        }
    }
}

// A Tesla-style switch: a pill, blue and knob right when on.
void toggle_switch(gfx::DrawList & l, float right, float cy, bool on) {
    const Rect r{ right - 64, cy - 18, 64, 36 };
    l.rounded_rect(r, 18, on ? kAccent : kHair);
    l.circle(on ? r.x + r.w - 18 : r.x + 18, cy, 14, on ? kBase : kInk2);
}

// Greedy word wrap to `width`; a word longer than a line is cut. A language
// written without spaces (Chinese) arrives as one long word, so a line that
// still does not fit is broken between characters: every UTF-8 sequence stays
// whole, or the last one would turn into U+FFFD.
std::vector<std::string> wrap(const ui::FontRef & f, const std::string & raw, float size, float width) {
    std::string text = raw;  // line breaks and tabs have no glyph: spaces
    std::replace_if(text.begin(), text.end(), [](char c) { return c == '\n' || c == '\r' || c == '\t'; }, ' ');
    std::vector<std::string> lines;
    std::string line;
    size_t at = 0;
    while (at < text.size()) {
        size_t end = text.find(' ', at);
        if (end == std::string::npos) {
            end = text.size();
        }
        const std::string word = text.substr(at, end - at);
        const std::string next = line.empty() ? word : line + " " + word;
        if (!line.empty() && f.measure(next, size) > width) {
            lines.push_back(line);
            line = word;
        } else {
            line = next;
        }
        at = end + 1;
    }
    if (!line.empty()) {
        lines.push_back(line);
    }
    std::vector<std::string> wrapped;
    for (const auto & l : lines) {
        if (f.measure(l, size) <= width) {
            wrapped.push_back(l);
            continue;
        }
        std::string current;
        for (size_t i = 0; i < l.size();) {
            const auto lead = (unsigned char) l[i];
            size_t length = lead >= 0xf0 ? 4 : lead >= 0xe0 ? 3 : lead >= 0xc0 ? 2 : 1;
            if (i + length > l.size()) {
                length = 1;
            }
            const std::string piece = l.substr(i, length);
            if (!current.empty() && f.measure(current + piece, size) > width) {
                wrapped.push_back(current);
                current = piece;
            } else {
                current += piece;
            }
            i += length;
        }
        if (!current.empty()) {
            wrapped.push_back(current);
        }
    }
    for (auto & l : wrapped) {
        l = f.font->fit(l, size, width);
    }
    return wrapped;
}

int first_visible(int cursor, int rows) {
    return std::clamp(cursor - kVisibleRows / 2, 0, std::max(0, rows - kVisibleRows));
}

// 2 error, 1 warning, 0 neither. llama.cpp marks its lines " E " and " W ";
// the rest is matched by words, so "failures=0" is not an error.
int log_level(const std::string & line) {
    std::string low = line;
    std::transform(low.begin(), low.end(), low.begin(), [](unsigned char ch) { return (char) std::tolower(ch); });
    const auto has = [&](const char * w) { return low.find(w) != std::string::npos; };
    if (line.find(" E ") != std::string::npos || has("error") || has("failed") || has("exception") || has("fatal") ||
        has("abort")) {
        return 2;
    }
    if (line.find(" W ") != std::string::npos || has("warn")) {
        return 1;
    }
    return 0;
}

// "2.1 of 10.4 GB, 3.8 MB/s, 37 min left", or the note of one that waits.
std::string download_line(const Download & d) {
    char t[200];
    const double done = d.done / 1073741824.0, all = d.bytes / 1073741824.0;
    if (d.state == DownloadState::running && d.mbps > 0.05) {
        const double left_s = (double) (d.bytes - std::min(d.done, d.bytes)) / (d.mbps * 1e6);
        if (left_s >= 3600) {
            std::snprintf(t, sizeof(t), "%.1f / %.1f GB, %.1f MB/s, 剩 %.0f 小时 %02.0f 分", done, all, d.mbps,
                          std::floor(left_s / 3600), std::fmod(left_s / 60, 60));
        } else {
            std::snprintf(t, sizeof(t), "%.1f / %.1f GB, %.1f MB/s, 剩 %.0f 分钟", done, all, d.mbps, std::ceil(left_s / 60));
        }
        return t;
    }
    std::snprintf(t, sizeof(t), "%.1f / %.1f GB", done, all);
    if (d.state == DownloadState::running) {
        return std::string(t) + "，启动中";
    }
    if (d.state == DownloadState::done) {
        return d.note;
    }
    if (!d.note.empty()) {
        return std::string(t) + ", " + d.note;
    }
    return d.state == DownloadState::queued ? std::string(t) + "，排队等候" : t;
}

// The value of a setting as its row shows it, and one step of it.
std::string setting_text(const Settings & s, Setting id, const std::vector<ModelRow> & models,
                         const std::vector<Drive> & drives) {
    switch (id) {
        case Setting::default_model: {
            if (s.default_model.empty()) {
                return "无";
            }
            for (const auto & m : models) {
                if (m.file == s.default_model) {
                    std::string name, build;
                    split_name(m.label, &name, &build);
                    return name + "  " + build;
                }
            }
            return "缺失";
        }
        case Setting::boot_list: {
            if (s.boot_models.empty()) {
                return "全按需";
            }
            return std::to_string(s.boot_models.size()) + " 个模型";
        }
        case Setting::ctx_cap: return format("%.0fk token", s.ctx_cap / 1024.0);
        case Setting::kv_type: return s.kv_type == "auto" ? "Auto" : s.kv_type;
        case Setting::text_slot:    return std::to_string(s.text_slot) + " 号" + "（:" + std::to_string(8000 + s.text_slot) + "）";
        case Setting::picture_slot: return std::to_string(s.picture_slot) + " 号" + "（:" + std::to_string(8000 + s.picture_slot) + "）";
        case Setting::speech_slot:  return std::to_string(s.speech_slot) + " 号" + "（:" + std::to_string(8000 + s.speech_slot) + "）";
        case Setting::parallel: return s.parallel_slots <= 1 ? "排队（1 路）"
                                                             : ("并发 " + std::to_string(s.parallel_slots) + " 路");
        case Setting::scratch_limit: return format("%.0f GB", (double) s.scratch_limit_gib);
        case Setting::tts_backbone:
        case Setting::tts_mmproj:
        case Setting::voices_dir:
        case Setting::sd_diffusion:
        case Setting::sd_video:
        case Setting::sd_clip_l:
        case Setting::sd_clip_g:
        case Setting::sd_t5xxl:
        case Setting::sd_vae:
        case Setting::sd_esrgan: {
            const std::string & path = id == Setting::tts_backbone ? s.tts_backbone
                                     : id == Setting::tts_mmproj   ? s.tts_mmproj
                                     : id == Setting::voices_dir   ? s.voices_dir
                                     : id == Setting::sd_diffusion ? s.sd_diffusion
                                     : id == Setting::sd_video     ? s.sd_video
                                     : id == Setting::sd_clip_l    ? s.sd_clip_l
                                     : id == Setting::sd_clip_g    ? s.sd_clip_g
                                     : id == Setting::sd_t5xxl     ? s.sd_t5xxl
                                     : id == Setting::sd_vae       ? s.sd_vae
                                                                   : s.sd_esrgan;
            if (path.empty()) {
                return id == Setting::sd_video ? "同图像模型" : "无";
            }
            const size_t slash = path.find_last_of('/');
            return slash == std::string::npos ? path : path.substr(slash + 1);
        }
        case Setting::tts_lang: return s.tts_lang;
        case Setting::sd_frames: return std::to_string(s.sd_frames) + " 帧";
        case Setting::sd_fps: return std::to_string(s.sd_fps) + " fps";
        case Setting::sd_size: return std::to_string(s.sd_width) + "×" + std::to_string(s.sd_height);
        case Setting::sd_steps: return std::to_string(s.sd_steps);
        case Setting::sd_cfg: return format("%.1f", s.sd_cfg_x10 / 10.0);
        case Setting::download_dir: {
            for (const auto & d : drives) {
                if (d.models == s.download_dir) {
                    return d.name;
                }
            }
            return s.download_dir.rfind("/mnt/ext", 0) == 0 ? "M.2 硬盘，未找到" : "USB 硬盘，未找到";
        }
        default: return "";
    }
}

bool is_toggle(Setting id) { return id == Setting::auto_load || id == Setting::sounds || id == Setting::tools || id == Setting::introspect; }

bool toggle_value(const Settings & s, Setting id) {
    switch (id) {
        case Setting::auto_load:  return s.auto_load;
        case Setting::sounds:     return s.sounds;
        case Setting::tools:      return s.tools;
        case Setting::introspect: return s.introspect;
        default:                  return false;
    }
}

// 启动加载清单里能勾的：能自己撑起一个引擎的主干模型。
// 配件（codec / 文本编码器 / VAE / 放大）不列 —— 它们归各自那行管。
// 判据用 row.arch：非文字模型的 arch 就是 model_kind() 的值；文字模型的 arch 是
// GGUF 里的架构名（qwen3 / llama / ...），所以「不是配件」就等于文字模型。
std::vector<const ModelRow *> boot_items(const std::vector<ModelRow> & models) {
    std::vector<const ModelRow *> out;
    for (const auto & m : models) {
        const bool parts = m.arch == "text-encoder" || m.arch == "vae" || m.arch == "upscaler" ||
                           m.arch == "projector";
        if (!parts) {
            out.push_back(&m);
        }
    }
    return out;
}

// 这一行的当前选择会不会把内存撑爆。目前只有「并发」有这个问题：
// 并发 N 路就要 N 份 KV，模型越大越撑不住。
bool setting_warns(const Settings & s, Setting id, const Live & live) {
    if (id != Setting::parallel || s.parallel_slots <= 1) {
        return false;
    }
    if (live.pool_gib <= 0.01) {
        return false;
    }
    const double need = live.model_gib + live.kv_gib * (double) s.parallel_slots + 0.75;
    return need > live.pool_gib;
}

// A row's choices, for the list X opens under it: each with the settings it
// would make, and whether it is the one set now.
struct Choice {
    std::string label, note;
    Settings    value;
    bool        current = false;
};

std::vector<Choice> choices_of(const Settings & s, Setting id, const std::vector<ModelRow> & models,
                               const std::vector<Drive> & drives) {
    std::vector<Choice> out;
    const auto add = [&](std::string label, std::string note, bool current, auto set) {
        Choice c{ std::move(label), std::move(note), s, current };
        set(c.value);
        out.push_back(std::move(c));
    };
    switch (id) {
        case Setting::default_model:
            add("无", "等待选择", s.default_model.empty(), [](Settings & v) { v.default_model.clear(); });
            for (const auto & m : models) {
                if (m.fits) {
                    std::string name, build;
                    split_name(m.label, &name, &build);
                    add(name + "  " + build, gb(m.size_gib), m.file == s.default_model,
                        [&](Settings & v) { v.default_model = m.file; });
                }
            }
            break;
        case Setting::ctx_cap:
            for (uint32_t c : kCtxSteps) {
                add(format("%.0fk token", c / 1024.0), "", s.ctx_cap == c, [c](Settings & v) { v.ctx_cap = c; });
            }
            break;
        case Setting::kv_type: {
            const char * notes[] = { "能放下的最佳值", "完整精度，占内存最多", "接近完整精度，内存减半",
                                     "四分之一内存" };
            for (int i = 0; i < 4; ++i) {
                const std::string t = kKvSteps[i];
                add(i == 0 ? "Auto" : t, notes[i], s.kv_type == t, [&](Settings & v) { v.kv_type = t; });
            }
            break;
        }
        case Setting::scratch_limit:
            for (uint32_t g : kScratchSteps) {
                add(format("%.0f GB", (double) g), "", s.scratch_limit_gib == g, [g](Settings & v) { v.scratch_limit_gib = g; });
            }
            break;
        case Setting::download_dir:
            for (const auto & d : drives) {
                add(d.name, d.total > 0 ? gb(d.free) + " free" : "", d.models == s.download_dir,
                    [&](Settings & v) { v.download_dir = d.models; });
            }
            break;
        // The engine models: every file of the kind that engine reads, plus "none".
        case Setting::tts_backbone:
        case Setting::tts_mmproj:
        case Setting::sd_diffusion:
        case Setting::sd_video:
        case Setting::sd_clip_l:
        case Setting::sd_clip_g:
        case Setting::sd_t5xxl:
        case Setting::sd_vae:
        case Setting::sd_esrgan: {
            const bool want_mmproj = id == Setting::tts_mmproj;
            const bool sz          = id == Setting::sd_vae || id == Setting::sd_esrgan;
            const bool clip_want   = id == Setting::sd_clip_l || id == Setting::sd_clip_g;
            // 这一行改的是哪一份字段：九行共用，省得每行写三层三元
            const auto field = [id](Settings & v) -> std::string & {
                switch (id) {
                    case Setting::tts_backbone: return v.tts_backbone;
                    case Setting::tts_mmproj:   return v.tts_mmproj;
                    case Setting::sd_diffusion: return v.sd_diffusion;
                    case Setting::sd_video:     return v.sd_video;
                    case Setting::sd_clip_l:    return v.sd_clip_l;
                    case Setting::sd_clip_g:    return v.sd_clip_g;
                    case Setting::sd_t5xxl:     return v.sd_t5xxl;
                    case Setting::sd_vae:       return v.sd_vae;
                    default:                    return v.sd_esrgan;
                }
            };
            Settings scratch = s;   // 只为读「当前是哪个」，省得写 const 重载
            add("无", "这个引擎不起", field(scratch).empty(), [field](Settings & v) { field(v).clear(); });
            for (const auto & m : models) {
                // 由文件自己说它是什么：GGUF 读 architecture，其余看扩展名
                const std::string kind = model_kind(m.file);
                const bool is_mmproj = kind == "projector";
                const bool is_safe   = kind == "vae" || kind == "upscaler" ||
                                       (m.file.size() > 12 && m.file.rfind(".safetensors") == m.file.size() - 12);
                const bool is_pt     = m.file.size() > 4 && m.file.rfind(".pth") == m.file.size() - 4;
                if (want_mmproj) {
                    if (!is_mmproj) {
                        continue;
                    }
                } else if (is_mmproj) {
                    continue;
                } else if (sz) {
                    if (!is_safe && !is_pt) {
                        continue;
                    }
                } else if (clip_want) {
                    // CLIP-L / CLIP-G：safetensors 或 gguf 都行，不要 VAE、不要放大、不要 .pth
                    if (kind == "vae" || kind == "upscaler" || is_pt) {
                        continue;
                    }
                } else {
                    if (is_safe || is_pt) {
                        continue;
                    }
                }
                std::string name, build;
                split_name(m.label, &name, &build);
                add(name + "  " + build, gb(m.size_gib), field(scratch) == m.file,
                    [field, file = m.file](Settings & v) { field(v) = file; });
            }
            break;
        }
        case Setting::voices_dir:
            add("内置 /data/PS5MM/voices", "放在 app 自己的目录里", s.voices_dir == "/data/PS5MM/voices",
                [](Settings & v) { v.voices_dir = "/data/PS5MM/voices"; });
            break;
        case Setting::sd_size: {
            static const int sizes[][2] = { { 512, 512 }, { 832, 480 }, { 1024, 1024 }, { 1280, 704 } };
            for (const auto & wh : sizes) {
                add(std::to_string(wh[0]) + "×" + std::to_string(wh[1]), "", s.sd_width == wh[0] && s.sd_height == wh[1],
                    [&](Settings & v) { v.sd_width = wh[0]; v.sd_height = wh[1]; });
            }
            break;
        }
        case Setting::sd_steps: {
            static const int steps[] = { 4, 8, 12, 20, 30, 50 };
            for (int n : steps) {
                add(std::to_string(n) + " 步", "", s.sd_steps == n, [n](Settings & v) { v.sd_steps = n; });
            }
            break;
        }
        case Setting::sd_cfg: {
            static const int cfgs[] = { 10, 20, 35, 50, 70, 90 };
            for (int c : cfgs) {
                add(format("%.1f", c / 10.0), "", s.sd_cfg_x10 == c, [c](Settings & v) { v.sd_cfg_x10 = c; });
            }
            break;
        }
        // 三个槽位选择器：1..5，把另外两个引擎已经占掉的排掉，免得撞端口
        case Setting::text_slot:
        case Setting::picture_slot:
        case Setting::speech_slot: {
            const int taken_a = id == Setting::text_slot ? s.picture_slot : s.text_slot;
            const int taken_b = id == Setting::speech_slot ? s.picture_slot : s.speech_slot;
            const int mine    = id == Setting::text_slot    ? s.text_slot
                              : id == Setting::picture_slot ? s.picture_slot
                                                            : s.speech_slot;
            for (int slot = 1; slot <= 5; ++slot) {
                if (slot == taken_a || slot == taken_b) {
                    continue;   // 被另外两个引擎占了
                }
                add(std::to_string(slot) + " 号", "端口 " + std::to_string(8000 + slot), mine == slot,
                    [id, slot](Settings & v) {
                        if (id == Setting::text_slot) {
                            v.text_slot = slot;
                        } else if (id == Setting::picture_slot) {
                            v.picture_slot = slot;
                        } else {
                            v.speech_slot = slot;
                        }
                    });
            }
            break;
        }
        case Setting::parallel: {
            add("排队（1 路）", "请求依次处理，KV 只占一份", s.parallel_slots == 1,
                [](Settings & v) { v.parallel_slots = 1; });
            add("并发 2 路", "同时接两个请求，KV 缓存翻倍", s.parallel_slots == 2,
                [](Settings & v) { v.parallel_slots = 2; });
            add("并发 3 路", "三份 KV；只有小模型撑得住", s.parallel_slots == 3,
                [](Settings & v) { v.parallel_slots = 3; });
            break;
        }
        case Setting::tts_lang: {
            // Qwen3-TTS 的音色是中性参考音，语种在这里点一句它就跟上
            static const char * langs[][2] = { { "zh", "中文" }, { "en", "英文" }, { "ja", "日文" },
                                               { "ko", "韩文" }, { "fr", "法文" }, { "de", "德文" },
                                               { "es", "西班牙文" } };
            for (const auto & l : langs) {
                add(l[1], l[0], s.tts_lang == l[0], [code = std::string(l[0])](Settings & v) { v.tts_lang = code; });
            }
            break;
        }
        case Setting::sd_frames: {
            static const int frames[] = { 5, 9, 17, 33, 49, 65, 81 };
            for (int n : frames) {
                add(std::to_string(n) + " 帧", n > 33 ? "显存吃紧" : "", s.sd_frames == n,
                    [n](Settings & v) { v.sd_frames = n; });
            }
            break;
        }
        case Setting::sd_fps: {
            static const int fps[] = { 8, 12, 16, 24, 30 };
            for (int n : fps) {
                add(std::to_string(n) + " fps", "", s.sd_fps == n, [n](Settings & v) { v.sd_fps = n; });
            }
            break;
        }
        default: break;
    }
    return out;
}

// The base name a suggestion's model file has on the console.
const char * local_name(const SuggestedFile & f) { return f.save_as ? f.save_as : f.file; }

// What Square sends from Home, in turn: something to show the model off with.
constexpr const char * kChatDemos[] = {
    "两句话说明 PS5 怎么跑语言模型？",
    "写一首俳句：一台用 token 做梦的游戏机。",
    "给住在电视下面的家用 AI 服务器起三个名字。",
    "17 乘 23 是多少？一行里给出步骤。",
};
constexpr const char * kDecisionDemos[] = {
    "这个月被扣了两次费。退钱，不然我退订。",
    "新版太棒了，一切都快多了！",
    "上个月的发票在哪看？",
    "第三次问了。今天就退订。",
};
constexpr int kDemos = 4;

}  // namespace

// ---- state ------------------------------------------------------------------------

Dashboard::Dashboard(const ui::Fonts & fonts) : fonts_(fonts) {
    // The message prompt in the dashboard's own colours, with Turkish letters
    // over the space bar.
    ui::Theme & t = prompt_.style.theme;
    t.page = kBase;
    t.surface = kSurface;
    t.surface_high = kRaised;
    t.text = t.page_text = kInk;
    t.text_muted = t.page_text_muted = kInk2;
    t.primary = t.accent = kAccent;
    t.on_primary = t.on_secondary = kInk;
    t.secondary = kRaised;
    t.outline = kHair;
    t.focus = kAccent;
    t.heading = ui::FontRole::semibold;
    t.radius = 14;
    t.radius_card = 24;
    prompt_.style.frosted = false;
    prompt_.style.width = 1100;
    prompt_.style.max_length = 400;
    prompt_.keyboard.style.bindings = ui::KeyboardBindings::standard();
    prompt_.keyboard.style.pitch_by_column = false;
    prompt_.keyboard.style.erase = Cue::type;
    ui::KeyboardLayout letters = ui::KeyboardLayout::letters();
    const char * tr[][2] = { { "\xC3\xA7", "\xC3\x87" }, { "\xC4\x9F", "\xC4\x9E" }, { "\xC4\xB1", "I" },
                             { "\xC4\xB0", "\xC4\xB0" }, { "\xC3\xB6", "\xC3\x96" }, { "\xC5\x9F", "\xC5\x9E" },
                             { "\xC3\xBC", "\xC3\x9C" } };
    std::vector<ui::KeyboardKey> row;
    for (const auto & k : tr) {
        row.push_back({ ui::KeyKind::character, k[0], k[1] });
    }
    letters.rows.insert(letters.rows.end() - 1, row);
    prompt_.keyboard.set_layouts({ letters, ui::KeyboardLayout::symbols() });
}

void Dashboard::open_library() {
    page_from_ = page_;
    page_ = kModelsPage;
    page_age_ = 0;
    section_ = kLocal;
    in_list_ = true;
    local_cursor_ = 0;
    for (int i = 0; i < (int) live_.models.size(); ++i) {
        if (live_.models[(size_t) i].current) {
            local_cursor_ = i;
        }
    }
}

void Dashboard::show_downloads() {
    go_to(kModelsPage, nullptr);
    section_ = kDownloads;
    in_list_ = true;
}

bool Dashboard::wants_logs() const { return page_ == kMonitorPage; }

void Dashboard::go_to(int page, ui::Feedback * feedback) {
    page_from_ = page_;
    page_ = page;
    page_age_ = 0;
    if (feedback) {
        feedback->play(Cue::tab);
    }
}

void Dashboard::set_logs(std::vector<std::string> app, std::vector<std::string> llama) {
    app_log_ = std::move(app);
    llama_log_ = std::move(llama);
    refilter_logs();
}

void Dashboard::refilter_logs() {
    const auto keep = [&](const std::string & line) { return !log_errors_ || log_level(line) > 0; };
    app_view_.clear();
    llama_view_.clear();
    std::copy_if(app_log_.begin(), app_log_.end(), std::back_inserter(app_view_), keep);
    std::copy_if(llama_log_.begin(), llama_log_.end(), std::back_inserter(llama_view_), keep);
    log_scroll_ = std::min(log_scroll_, std::max(0, (int) log_view().size() - kLogLines));
}

// ---- input ------------------------------------------------------------------------

void Dashboard::update(const hui::InputFrame & raw, float dt, ui::Feedback & feedback) {
    const hui::InputFrame none{};
    const bool dialog = market_confirm_ || market_space_ || picker_ || slot_pick_;
    const hui::InputFrame & input = busy() ? none : raw;  // busy: the screen says so, buttons wait
    age_ += dt;
    clock_ += dt;
    page_age_ += dt;

    // The load's share moves on every frame, not once a second as it is measured.
    const float load = live_.state == ServerState::loading ? std::max(0.0f, live_.load_progress) : 0.0f;
    load_shown_ = load < load_shown_ ? load : load_shown_ + (load - load_shown_) * std::min(1.0f, dt * 2.5f);

    // Two sounds come from events, not buttons: a model ready, a download saved.
    const bool serving = live_.state == ServerState::ready || live_.state == ServerState::generating;
    if (serving && !was_serving_) {
        feedback.play(Cue::notify);
    }
    was_serving_ = serving;
    std::vector<std::string> unfinished;
    for (const auto & d : market_.downloads) {
        if (d.state != DownloadState::done) {
            unfinished.push_back(d.file);
        } else if (std::find(unfinished_.begin(), unfinished_.end(), d.file) != unfinished_.end()) {
            feedback.play(Cue::complete);
        }
    }
    unfinished_ = std::move(unfinished);

    // L1/R1 walk the dock, unless a question is open. A message being typed
    // takes every button until it is sent or dropped.
    const int step = input.is_pressed(Action::page_next) ? 1 : input.is_pressed(Action::page_prev) ? -1 : 0;
    if (prompt_.is_open()) {
        if (prompt_.handle(input, feedback) == ui::Event::activated) {
            request_ = { Request::ask, prompt_.text() };
        }
    } else if (step != 0 && !dialog) {
        const int next = page_ + step;
        if (next >= 0 && next < kPages) {
            go_to(next, &feedback);
        } else {
            feedback.play(Cue::error);
        }
    } else if (page_ == kHomePage) {
        update_home(input, feedback);
    } else if (page_ == kModelsPage) {
        update_models(input, feedback);
    } else if (page_ == kEndpointsPage) {
        update_endpoints(input, feedback);
    } else if (page_ == kMonitorPage) {
        update_monitor(input, feedback);
    } else if (page_ == kSettingsPage) {
        update_settings(input, feedback);
    }
    prompt_.update(dt);

    // Where the highlight goes: a section or a row on Models, a category or a
    // row on Settings.
    float target = kListY;
    if (page_ == kModelsPage) {
        int row = section_;
        if (in_list_) {
            const int cursor = section_ == kSlots ? slot_cursor_ : section_ == kLocal ? local_cursor_
                             : section_ == kSuggested ? suggested_cursor_
                             : section_ == kDownloads ? dl_cursor_ : market_files_ ? market_file_ : market_repo_;
            const int count = section_ == kSlots ? 5 : section_ == kLocal ? (int) live_.models.size()
                            : section_ == kSuggested ? kSuggestionCount
                            : section_ == kDownloads ? (int) market_.downloads.size()
                            : market_files_ && market_.open >= 0 && market_.open < (int) market_.repos.size()
                                ? (int) market_.repos[(size_t) market_.open].files.size() : (int) market_.repos.size();
            row = cursor - first_visible(cursor, count);
            target = kListY + (section_ == kSearch ? 72.0f : 0.0f) + (float) row * kRowPitch;
        } else {
            target = kListY + (float) row * kRailPitch;
        }
    } else if (page_ == kSettingsPage) {
        target = in_rows_ ? kListY + (float) setting_row_ * kRowPitch
                          : kListY + (float) setting_category_ * kRailPitch;
    }
    if (age_ <= dt) {
        rows_y_.snap(target);
    }
    rows_y_.target = target;
    rows_y_.update(dt, 22.0f);
    dock_x_.target = (float) page_;
    dock_x_.update(dt, 18.0f);
}

void Dashboard::update_home(const hui::InputFrame & input, ui::Feedback & feedback) {
    if (input.is_pressed(Action::jump_prev) || input.is_pressed(Action::jump_next)) {
        // LT / RT：总览两种视图之间来回（五席位通道条 / 对话详情）
        home_view_ = home_view_ == 0 ? 1 : 0;
        feedback.play(Cue::tab);
        return;
    }
    const bool decision = !live_.decision.empty();
    const bool serving = live_.state == ServerState::ready || live_.state == ServerState::generating;
    if (home_view_ == 0) {
        // 通道条视图：左右在五个席位之间走，X 去「模型」页管这个槽位。
        if (input.nav == Direction::left || input.nav == Direction::right) {
            const int next = ov_cursor_ + (input.nav == Direction::right ? 1 : -1);
            if (next >= 0 && next < 5) {
                ov_cursor_ = next;
                feedback.play(Cue::focus);
            } else if (!input.nav_repeat) {
                feedback.play(Cue::error);
            }
            return;
        }
        if (input.is_pressed(Action::confirm)) {
            go_to(kModelsPage, &feedback);
            section_     = kSlots;
            in_list_     = true;
            slot_cursor_ = ov_cursor_;
            return;
        }
    } else if (input.is_pressed(Action::confirm)) {
        open_library();
        feedback.play(Cue::select);
        return;
    }
    if ((input.is_pressed(Action::west) || input.is_pressed(Action::north)) && !serving) {
        feedback.play(Cue::error);  // nothing answers yet
    } else if (input.is_pressed(Action::west)) {
        request_ = { Request::ask, (decision ? kDecisionDemos : kChatDemos)[demo_++ % kDemos] };
        feedback.play(Cue::select);
    } else if (input.is_pressed(Action::north)) {
        prompt_.set_title(decision ? "待判断的文本" : "消息");
        prompt_.field.set_placeholder(decision ? "A customer message, a review, a ticket" : "问点什么");
        prompt_.open(feedback);
    }
}

void Dashboard::update_models(const hui::InputFrame & input, ui::Feedback & feedback) {
    if (slot_pick_) {
        update_slot_picker(input, feedback);
        return;
    }
    if (market_confirm_ || market_space_) {
        update_market(input, feedback);
        return;
    }
    if (!in_list_) {
        if (input.nav == Direction::up || input.nav == Direction::down) {
            const int next = section_ + (input.nav == Direction::down ? 1 : -1);
            if (next >= 0 && next < kSections) {
                section_ = next;
                feedback.play(Cue::focus);
                if (section_ == kSearch && !market_searched_) {
                    market_searched_ = true;
                    request_ = { Request::market_search, "" };
                }
            } else if (!input.nav_repeat) {
                feedback.play(Cue::error);
            }
        }
        if (input.nav == Direction::right || input.is_pressed(Action::confirm)) {
            in_list_ = true;
            feedback.play(Cue::select);
        }
        return;
    }
    // Left from a list's top level, or Circle there, goes back to the sections.
    const bool top = !(section_ == kSearch && market_files_);
    if (top && (input.nav == Direction::left || input.is_pressed(Action::back))) {
        in_list_ = false;
        dl_confirm_ = -1;
        feedback.play(Cue::back);
        return;
    }
    switch (section_) {
        case kSlots: update_slots(input, feedback); break;
        case kLocal: update_local(input, feedback); break;
        case kSuggested: update_suggested(input, feedback); break;
        case kSearch: update_market(input, feedback); break;
        default: update_downloads(input, feedback); break;
    }
}

namespace {
bool walk(const hui::InputFrame & input, int & cursor, int count, ui::Feedback & feedback);
}

// 槽位能装什么模型，由文件自己说的类型（model_kind，存在 row.arch 上）决定：
// 文字槽只收文字/决策主干，图像槽收图像/视频，语音槽收语音，配件谁也不收。
std::vector<const ModelRow *> slot_items(int slot, const std::vector<ModelRow> & models) {
    std::vector<const ModelRow *> out;
    for (const auto & m : models) {
        const bool parts = m.arch == "text-encoder" || m.arch == "vae" || m.arch == "upscaler" ||
                           m.arch == "projector";
        if (parts) {
            continue;
        }
        // 槽位 3 是语音，槽位 4 是音频（audio.cpp 吃 gguf），槽位 5 是三维。
        // 后两个引擎其实读固定路径（见下面 update_slots 的说明），这里只是让候选
        // 列表别空着误导人。
        const bool is_gguf = m.file.size() > 5 &&
                             m.file.compare(m.file.size() - 5, 5, ".gguf") == 0;
        const bool ok = slot == 1 ? (m.arch != "speech" && m.arch != "picture" && m.arch != "video")
                      : slot == 2 ? (m.arch == "picture" || m.arch == "video")
                      : slot == 3 ? (m.arch == "speech")
                      : slot == 4 ? (is_gguf && m.arch != "picture" && m.arch != "video")
                                  : false;
        if (ok) {
            out.push_back(&m);
        }
    }
    return out;
}

void Dashboard::update_slots(const hui::InputFrame & input, ui::Feedback & feedback) {
    walk(input, slot_cursor_, 5, feedback);
    const EngineCard * c = slot_cursor_ < (int) live_.engines.size() ? &live_.engines[(size_t) slot_cursor_] : nullptr;
    if (input.is_pressed(Action::confirm)) {
        if (!c || c->reserved) {
            feedback.play(Cue::error);  // 预留席位不接指派
            return;
        }
        // 光标停在当前指派上（「不指派」是第 0 行）
        slot_pick_cursor_ = 0;
        const auto items = slot_items(slot_cursor_ + 1, live_.models);
        const std::string & now = slot_cursor_ == 0 ? settings_.default_model
                                : slot_cursor_ == 1 ? settings_.sd_diffusion
                                                    : settings_.tts_backbone;
        for (int i = 0; i < (int) items.size(); ++i) {
            if (items[(size_t) i]->file == now) {
                slot_pick_cursor_ = i + 1;
            }
        }
        slot_pick_ = true;
        feedback.play(Cue::modal_open);
        return;
    }
    if (input.is_pressed(Action::west)) {
        if (!c || c->reserved) {
            feedback.play(Cue::error);
            return;
        }
        if (slot_cursor_ == 0) {
            // 文字槽：跑着就卸载（app 不带模型重启），没跑且有指派就加载。
            if (live_.state == ServerState::ready || live_.state == ServerState::generating) {
                request_ = { Request::unload, live_.model_file };
                feedback.play(Cue::select);
            } else if (!settings_.default_model.empty()) {
                request_ = { Request::load, settings_.default_model };
                feedback.play(Cue::launch);
            } else {
                feedback.play(Cue::error);  // 先指派
            }
        } else if (slot_cursor_ == 1) {
            // 图像槽：可以预加载；运行中的引擎没有卸载接口，不装。
            if (c->state == "等第一次请求" && !settings_.sd_diffusion.empty()) {
                request_ = { Request::sd_preload, "" };
                feedback.play(Cue::launch);
            } else {
                feedback.play(Cue::error);
            }
        } else {
            feedback.play(Cue::error);  // 语音槽只随启动加载：设置里改，下次开机生效
        }
    }
}

void Dashboard::update_slot_picker(const hui::InputFrame & input, ui::Feedback & feedback) {
    const auto items = slot_items(slot_cursor_ + 1, live_.models);
    const int  count = (int) items.size() + 1;  // 第 0 行是「不指派」
    slot_pick_cursor_ = std::clamp(slot_pick_cursor_, 0, std::max(0, count - 1));
    walk(input, slot_pick_cursor_, count, feedback);
    if (input.is_pressed(Action::confirm)) {
        std::string & field = slot_cursor_ == 0 ? settings_.default_model
                            : slot_cursor_ == 1 ? settings_.sd_diffusion
                                                : settings_.tts_backbone;
        field = slot_pick_cursor_ == 0 ? std::string() : items[(size_t) slot_pick_cursor_ - 1]->file;
        request_ = { Request::settings, "" };
        slot_pick_ = false;
        feedback.play(Cue::select);
    } else if (input.is_pressed(Action::back)) {
        slot_pick_ = false;
        feedback.play(Cue::modal_close);
    }
}

namespace {

// Up and down through a list: true when the cursor moved.
bool walk(const hui::InputFrame & input, int & cursor, int count, ui::Feedback & feedback) {
    if (input.nav != Direction::up && input.nav != Direction::down) {
        return false;
    }
    const int next = cursor + (input.nav == Direction::down ? 1 : -1);
    if (next >= 0 && next < count) {
        cursor = next;
        feedback.play(Cue::focus);
        return true;
    }
    if (!input.nav_repeat) {
        feedback.play(Cue::error);
    }
    return false;
}

}  // namespace

void Dashboard::update_local(const hui::InputFrame & input, ui::Feedback & feedback) {
    const int rows = (int) live_.models.size();
    local_cursor_ = std::clamp(local_cursor_, 0, std::max(0, rows - 1));
    walk(input, local_cursor_, rows, feedback);
    if (input.is_pressed(Action::confirm) && rows > 0) {
        const ModelRow & m = live_.models[(size_t) local_cursor_];
        if (m.current) {
            request_ = { Request::unload, m.file };
            feedback.play(Cue::select);
        } else if (m.fits) {
            request_ = { Request::load, m.file };
            feedback.play(Cue::launch);
        } else {
            feedback.play(Cue::error);
        }
    }
}

void Dashboard::update_suggested(const hui::InputFrame & input, ui::Feedback & feedback) {
    walk(input, suggested_cursor_, kSuggestionCount, feedback);
    if (input.is_pressed(Action::confirm)) {
        const Suggestion & s = kSuggestions[suggested_cursor_];
        bool here = false;
        for (const auto & m : live_.models) {
            here = here || m.label + ".gguf" == local_name(s.model);
        }
        if (here) {
            feedback.play(Cue::error);
        } else {
            request_ = { Request::suggested_download, settings_.download_dir, suggested_cursor_ };
            feedback.play(Cue::select);
        }
    }
}

// After the space check: ask about a loaded model first, or start.
void Dashboard::start_download(ui::Feedback & feedback) {
    if (!live_.model_label.empty() && live_.free_gib < 2.0) {
        market_confirm_ = true;  // a model holds the memory: ask first
        feedback.play(Cue::modal_open);
    } else {
        request_ = { Request::market_download, market_dir_, market_.open, market_file_ };
        feedback.play(Cue::select);
    }
}

void Dashboard::update_market(const hui::InputFrame & input, ui::Feedback & feedback) {
    // The download does not fit where it would go.
    if (market_space_) {
        if (input.is_pressed(Action::confirm) && !market_dir_.empty()) {
            market_space_ = false;
            start_download(feedback);
        } else if (input.is_pressed(Action::back)) {
            market_space_ = false;
            feedback.play(Cue::modal_close);
        }
        return;
    }
    // The question before a download while a model holds the memory.
    if (market_confirm_) {
        if (input.is_pressed(Action::north)) {
            request_ = { Request::market_download_unload, market_dir_, market_.open, market_file_ };
            market_confirm_ = false;
            feedback.play(Cue::select);
        } else if (input.is_pressed(Action::confirm)) {
            request_ = { Request::market_download, market_dir_, market_.open, market_file_ };
            market_confirm_ = false;
            feedback.play(Cue::select);
        } else if (input.is_pressed(Action::back)) {
            market_confirm_ = false;
            feedback.play(Cue::modal_close);
        }
        return;
    }
    const int chip = input.is_pressed(Action::jump_next) ? 1 : input.is_pressed(Action::jump_prev) ? -1 : 0;
    if (chip != 0) {
        const int next = market_chip_ + chip;
        if (next >= 0 && next < kMarketChipCount) {
            market_chip_ = next;
            market_repo_ = 0;
            market_files_ = false;
            request_ = { Request::market_search, next == 0 ? std::string() : std::string(kMarketChips[next]) };
            feedback.play(Cue::tab);
        } else {
            feedback.play(Cue::error);
        }
        return;
    }
    const int repos = (int) market_.repos.size();
    const MarketRepo * open = market_.open >= 0 && market_.open < repos ? &market_.repos[(size_t) market_.open] : nullptr;
    const int files = open ? (int) open->files.size() : 0;
    int & cursor = market_files_ ? market_file_ : market_repo_;
    if (walk(input, cursor, market_files_ ? files : repos, feedback) && market_files_) {
        request_ = { Request::market_plan, "", market_.open, cursor };
    }
    if (input.is_pressed(Action::confirm)) {
        if (!market_files_ && cursor < repos) {
            request_ = { Request::market_open, "", cursor, -1 };
            market_files_ = true;
            market_file_ = 0;
            feedback.play(Cue::select);
        } else if (market_files_ && open && cursor < files) {
            const MarketFile & f = open->files[(size_t) cursor];
            const double need = f.bytes / 1073741824.0 + 1.0;  // and 1 GiB spare, as Market::download wants
            const Drive * to = nullptr;
            const Drive * other = nullptr;  // the roomiest other drive it fits on
            for (const auto & d : live_.drives) {
                if (d.models == settings_.download_dir) {
                    to = &d;
                } else if (d.free >= need && (!other || d.free > other->free)) {
                    other = &d;
                }
            }
            market_dir_.clear();
            if (f.fits == 0) {
                feedback.play(Cue::error);  // too big
            } else if (!to || (to->total > 0 && to->free < need)) {  // unknown space (no exporter) does not block
                market_space_ = true;
                market_dir_ = other ? other->models : "";
                feedback.play(Cue::modal_open);
            } else {
                start_download(feedback);
            }
        }
    }
    // Square: read this file's header now and say whether it fits.
    if (input.is_pressed(Action::west) && market_files_ && open && cursor < files) {
        const MarketFile & f = open->files[(size_t) cursor];
        if (f.fits == -1 || f.fits == -2) {
            request_ = { Request::market_plan, "", market_.open, cursor };
            feedback.play(Cue::select);
        } else {
            feedback.play(Cue::error);  // checked already
        }
    }
    if (input.is_pressed(Action::back) && market_files_) {
        market_files_ = false;
        feedback.play(Cue::back);
    }
    // The first file of a freshly opened repository gets planned too.
    if (request_.kind == Request::none && market_files_ && files > 0 && market_file_ == 0 && open->files[0].fits == -1 &&
        !open->files[0].checking && !market_.busy) {
        request_ = { Request::market_plan, "", market_.open, 0 };
    }
}

void Dashboard::update_downloads(const hui::InputFrame & input, ui::Feedback & feedback) {
    const int rows = (int) market_.downloads.size();
    dl_cursor_ = std::clamp(dl_cursor_, 0, std::max(0, rows - 1));
    if (walk(input, dl_cursor_, rows, feedback)) {
        dl_confirm_ = -1;
    }
    if (rows == 0) {
        return;
    }
    const Download & d = market_.downloads[(size_t) dl_cursor_];
    if (input.is_pressed(Action::confirm)) {
        if (d.state == DownloadState::running || d.state == DownloadState::retrying || d.state == DownloadState::queued) {
            request_ = { Request::download_pause, "", dl_cursor_ };
            feedback.play(Cue::select);
        } else if (d.state == DownloadState::paused || d.state == DownloadState::failed) {
            request_ = { Request::download_resume, "", dl_cursor_ };
            feedback.play(Cue::select);
        } else {
            feedback.play(Cue::error);
        }
    }
    // Square: a finished one leaves the list; any other is cancelled and its
    // partial file deleted, after a second press.
    if (input.is_pressed(Action::west)) {
        if (d.state == DownloadState::done || dl_confirm_ == dl_cursor_) {
            request_ = { Request::download_remove, "", dl_cursor_ };
            dl_confirm_ = -1;
            feedback.play(Cue::select);
        } else {
            dl_confirm_ = dl_cursor_;
            feedback.play(Cue::modal_open);
        }
    }
}

void Dashboard::update_monitor(const hui::InputFrame & input, ui::Feedback & feedback) {
    // L2 最近两分钟，R2 最近一小时；日志的滚动、换源、过滤走老规矩。
    const int to = input.is_pressed(Action::jump_next) ? 1 : input.is_pressed(Action::jump_prev) ? 0 : -1;
    if (to >= 0) {
        if ((to == 1) != console_hour_) {
            console_hour_ = to == 1;
            feedback.play(Cue::tab);
        } else {
            feedback.play(Cue::error);
        }
        return;
    }
    update_logs(input, feedback);
}

void Dashboard::update_settings(const hui::InputFrame & input, ui::Feedback & feedback) {
    if (picker_) {
        update_picker(input, feedback);
        return;
    }
    if (!in_rows_) {
        if (input.nav == Direction::up || input.nav == Direction::down) {
            const int next = setting_category_ + (input.nav == Direction::down ? 1 : -1);
            if (next >= 0 && next < kCategoryCount) {
                setting_category_ = next;
                setting_row_ = 0;
                log_scroll_ = 0;
                feedback.play(Cue::focus);
            } else if (!input.nav_repeat) {
                feedback.play(Cue::error);
            }
        }
        if (input.nav == Direction::right || input.is_pressed(Action::confirm)) {
            in_rows_ = true;
            feedback.play(Cue::select);
        }
        return;
    }
    if (input.is_pressed(Action::back) || input.nav == Direction::left) {
        in_rows_ = false;
        feedback.play(Cue::back);
        return;
    }
    const SettingCategory & c = kCategories[setting_category_];
    walk(input, setting_row_, c.count, feedback);
    const Setting id = c.rows[setting_row_].id;
    if (!input.is_pressed(Action::confirm)) {
        return;
    }
    // Cross does what the row is: clears, flips a switch, or opens its choices.
    if (id == Setting::boot_list) {
        // 多选清单：勾上的模型就是启动时预加载的
        multi_ = true;
        picker_ = true;
        picker_cursor_ = 0;
        feedback.play(Cue::modal_open);
    } else if (id == Setting::clear_scratch) {
        request_ = { Request::clear_scratch, "" };
        feedback.play(Cue::select);
    } else if (is_toggle(id)) {
        bool & on = id == Setting::auto_load  ? settings_.auto_load
                  : id == Setting::sounds     ? settings_.sounds
                  : id == Setting::tools      ? settings_.tools
                                              : settings_.introspect;
        on = !on;
        request_ = { Request::settings, "" };
        feedback.play(Cue::toggle);
    } else {
        const auto all = choices_of(settings_, id, live_.models, live_.drives);
        picker_ = true;
        picker_cursor_ = 0;
        for (int i = 0; i < (int) all.size(); ++i) {
            picker_cursor_ = all[(size_t) i].current ? i : picker_cursor_;
        }
        feedback.play(Cue::modal_open);
    }
}

void Dashboard::update_picker(const hui::InputFrame & input, ui::Feedback & feedback) {
    if (multi_) {
        // 启动加载清单：X 勾上／取消，Circle 收工。边勾边改，收工时落盘。
        const auto items = boot_items(live_.models);
        picker_cursor_ = std::clamp(picker_cursor_, 0, std::max(0, (int) items.size() - 1));
        walk(input, picker_cursor_, (int) items.size(), feedback);
        if (input.is_pressed(Action::confirm) && !items.empty()) {
            const std::string & file = items[(size_t) picker_cursor_]->file;
            auto & list = settings_.boot_models;
            const auto at  = std::find(list.begin(), list.end(), file);
            if (at == list.end()) {
                list.push_back(file);
            } else {
                list.erase(at);
            }
            request_ = { Request::settings, "" };
            feedback.play(Cue::toggle);
        } else if (input.is_pressed(Action::back)) {
            multi_ = false;
            picker_ = false;
            request_ = { Request::settings, "" };
            feedback.play(Cue::modal_close);
        }
        return;
    }
    const auto all = choices_of(settings_, kCategories[setting_category_].rows[setting_row_].id, live_.models, live_.drives);
    picker_cursor_ = std::clamp(picker_cursor_, 0, std::max(0, (int) all.size() - 1));
    walk(input, picker_cursor_, (int) all.size(), feedback);
    if (input.is_pressed(Action::confirm) && !all.empty()) {
        settings_ = all[(size_t) picker_cursor_].value;
        request_ = { Request::settings, "" };
        picker_ = false;
        feedback.play(Cue::select);
    } else if (input.is_pressed(Action::back)) {
        picker_ = false;
        feedback.play(Cue::modal_close);
    }
}

void Dashboard::update_logs(const hui::InputFrame & input, ui::Feedback & feedback) {
    const int most = std::max(0, (int) log_view().size() - kLogLines);
    if (input.nav == Direction::up || input.nav == Direction::down) {
        const int next = std::clamp(log_scroll_ + (input.nav == Direction::up ? 3 : -3), 0, most);
        if (next != log_scroll_) {
            log_scroll_ = next;
            feedback.play(Cue::focus);
        } else if (!input.nav_repeat) {
            feedback.play(Cue::error);
        }
    }
    if (input.is_pressed(Action::west)) {
        log_llama_ = !log_llama_;
        log_scroll_ = 0;
        feedback.play(Cue::tab);
    }
    if (input.is_pressed(Action::north)) {
        log_errors_ = !log_errors_;
        refilter_logs();
        log_scroll_ = 0;
        feedback.play(Cue::toggle);
    }
    if (input.is_pressed(Action::confirm)) {
        log_scroll_ = 0;  // back to the newest
        feedback.play(Cue::select);
    }
}

// ---- drawing: the frame ---------------------------------------------------------------

void Dashboard::draw(DashboardFrame & frame) const {
    frame.backdrop.mode = gfx::BackdropMode::gradient;
    frame.backdrop.colors[0] = Color::rgb(0x151618);
    frame.backdrop.colors[1] = kBase;
    frame.backdrop.colors[2] = kBase;
    frame.backdrop.time = clock_;

    gfx::DrawList & scene = frame.scene;
    // A page fades in and settles from a little below, the way a card rises
    // out of a car's dock.
    const float in = tween::cubic_out(tween::clamp01(page_age_ / 0.32f));
    scene.push_transform(1.0f, 960, 540, 0, 18.0f * (1.0f - in));
    scene.push_opacity(in);
    switch (page_) {
        case kHomePage: draw_home(scene); break;
        case kModelsPage: draw_models(scene); break;
        case kEndpointsPage: draw_endpoints(scene); break;
        case kMonitorPage: draw_monitor(scene); break;
        default: draw_settings(scene); break;
    }
    scene.pop_opacity();
    scene.pop_transform();
    draw_status(scene);
    draw_dock(scene);
    draw_hints(scene);
    draw_dialogs(frame.overlay);
    if (picker_ && page_ == kSettingsPage) {
        draw_picker(frame.overlay);
    }
    if (slot_pick_ && page_ == kModelsPage) {
        draw_slot_picker(frame.overlay);
    }
    if (prompt_.visible()) {
        ui::Canvas canvas{ frame.overlay, fonts_, 0, clock_ };
        prompt_.draw(canvas);
    }
    if (busy()) {
        draw_busy(frame.overlay);
    }
}

void Dashboard::draw_status(gfx::DrawList & l) const {
    const ui::Fonts & f = fonts_;
    const float y = 72;
    // 品牌：五笔频谱标（每一笔 = 一个引擎槽位的实时状态）+ 字标。
    draw_mark(l, kLeft, y - 26, 34, live_);
    put(l, f.semibold, "PS5MM", kLeft + 64, y, 28, kInk);
    // Right to left: how long it has been up, power, temperature.
    std::vector<std::string> items;
    if (live_.soc_temp > -100) {
        items.push_back(format("%.0f\xC2\xB0" "C", live_.soc_temp));
    }
    if (live_.soc_power_w > 0) {
        items.push_back(format("%.0f W", live_.soc_power_w));
    }
    if (live_.uptime_s > 0) {
        const double m = live_.uptime_s / 60.0;
        items.push_back(m < 60 ? format("已运行 %.0f 分钟", std::floor(m)) : format("已运行 %.1f 小时", m / 60.0));
    }
    float x = kRight;
    for (auto it = items.rbegin(); it != items.rend(); ++it) {
        x -= put(l, f.regular, *it, x, y, 22, kInk2, gfx::Align::right) + 40;
    }
    put(l, f.regular, "v" PS5LM_VERSION, x, y, 22, kInk3, gfx::Align::right);
}

void Dashboard::draw_dock(gfx::DrawList & l) const {
    const ui::Fonts & f = fonts_;
    l.line(kLeft, kDockY, kRight, kDockY, 1.5f, kHair);
    constexpr float pitch = 168;
    for (int i = 0; i < kPages; ++i) {
        const float cx = kLeft + 44 + pitch * (float) i;
        const float lit = tween::clamp01(1.0f - std::fabs(dock_x_.value - (float) i));
        const Color c = gfx::mix(kInk3, kInk, lit);
        icon(l, i, cx, 1004, c);
        put(l, f.regular, kPageNames[i], cx, 1056, 20, c, gfx::Align::center);
    }
    // The current tab's marker slides between them.
    const float mx = kLeft + 44 + pitch * dock_x_.value;
    l.rounded_rect({ mx - 18, 1068, 36, 4 }, 2, kAccent);
}

void Dashboard::draw_hints(gfx::DrawList & l) const {
    ui::GlyphStyle style = ui::GlyphStyle::dark();
    style.label = kInk2;
    ui::HintLayout layout;
    layout.size = 32;
    layout.text_size = 20;
    layout.cy = 1018;
    layout.item_gap = 36;
    std::vector<ui::Hint> h;
    if (market_confirm_ || market_space_ || prompt_.visible()) {
        return;  // the dialog has its own
    }
    if ((picker_ && page_ == kSettingsPage) || slot_pick_) {
        h = { { ui::Button::circle, "取消" }, { ui::Button::cross, "选择" } };
    } else if (page_ == kHomePage) {
        if (home_view_ == 0) {
            h = { { ui::Button::l1, "页面", ui::Button::r1 }, { ui::Button::l2, "视图", ui::Button::r2 },
                  { ui::Button::dpad, "槽位" }, { ui::Button::cross, "管理槽位" } };
        } else {
            h = { { ui::Button::l1, "页面", ui::Button::r1 }, { ui::Button::l2, "视图", ui::Button::r2 } };
            if (live_.state == ServerState::ready || live_.state == ServerState::generating) {
                h.push_back({ ui::Button::square, "示例" });
                h.push_back({ ui::Button::triangle, "消息" });
            }
            h.push_back({ ui::Button::cross, live_.model_label.empty() ? "选择模型" : "更换模型" });
        }
    } else if (page_ == kMonitorPage) {
        h = { { ui::Button::l1, "页面", ui::Button::r1 }, { ui::Button::l2, "范围", ui::Button::r2 },
              { ui::Button::dpad, "滚动日志" }, { ui::Button::square, log_llama_ ? "app 日志" : "服务器日志" },
              { ui::Button::triangle, log_errors_ ? "全部" : "仅错误" } };
    } else if (page_ == kModelsPage) {
        if (!in_list_) {
            h = { { ui::Button::dpad, "选择" }, { ui::Button::cross, "打开" } };
        } else if (section_ == kSlots) {
            const EngineCard * c = slot_cursor_ < (int) live_.engines.size() ? &live_.engines[(size_t) slot_cursor_] : nullptr;
            h = { { ui::Button::circle, "返回" } };
            if (c && !c->reserved) {
                h.push_back({ ui::Button::cross, "指派模型" });
                const char * act = slot_cursor_ == 0
                        ? (live_.state == ServerState::ready || live_.state == ServerState::generating ? "卸载" : "加载")
                        : slot_cursor_ == 1 ? "加载" : "仅启动加载";
                h.push_back({ ui::Button::square, act });
            }
        } else if (section_ == kLocal) {
            const ModelRow * m = local_cursor_ < (int) live_.models.size() ? &live_.models[(size_t) local_cursor_] : nullptr;
            h = { { ui::Button::circle, "返回" } };
            if (m && (m->current || m->fits)) {
                h.push_back({ ui::Button::cross, m->current ? "卸载" : "加载" });
            }
        } else if (section_ == kSuggested) {
            h = { { ui::Button::circle, "返回" }, { ui::Button::cross, "下载" } };
        } else if (section_ == kSearch) {
            h = market_files_ ? std::vector<ui::Hint>{ { ui::Button::circle, "返回" }, { ui::Button::square, "检查适配" },
                                                       { ui::Button::cross, "下载" } }
                              : std::vector<ui::Hint>{ { ui::Button::l2, "搜索", ui::Button::r2 }, { ui::Button::circle, "返回" },
                                                       { ui::Button::cross, "打开" } };
        } else {
            const Download * d = dl_cursor_ < (int) market_.downloads.size() ? &market_.downloads[(size_t) dl_cursor_] : nullptr;
            h = { { ui::Button::circle, "返回" } };
            if (d) {
                const bool runs = d->state == DownloadState::running || d->state == DownloadState::retrying ||
                                  d->state == DownloadState::queued;
                h.push_back({ ui::Button::square, d->state == DownloadState::done ? "清除" : dl_confirm_ == dl_cursor_ ? "是，删除" : "取消" });
                if (d->state != DownloadState::done) {
                    h.push_back({ ui::Button::cross, runs ? "暂停" : d->state == DownloadState::failed ? "重试" : "继续" });
                }
            }
        }
    } else if (page_ == kEndpointsPage) {
        h = { { ui::Button::l1, "页面", ui::Button::r1 }, { ui::Button::dpad, "端点" } };
    } else if (!in_rows_) {
        h = { { ui::Button::dpad, "选择" }, { ui::Button::cross, "打开" } };
    } else {
        const Setting id = kCategories[setting_category_].rows[setting_row_].id;
        if (id == Setting::clear_scratch) {
            h = { { ui::Button::circle, "返回" }, { ui::Button::cross, "清除" } };
        } else if (is_toggle(id)) {
            h = { { ui::Button::circle, "返回" }, { ui::Button::cross, "切换" } };
        } else {
            h = { { ui::Button::circle, "返回" }, { ui::Button::cross, "更改" } };
        }
    }
    ui::draw_hints(l, fonts_, style, h.data(), (int) h.size(), kRight, true, layout);
}

// ---- drawing: Home -------------------------------------------------------------------

// 总览视图 0：五个引擎席位，一页通道条。每条是一个槽位：槽位号、模态、
// 模型、状态、它手里握着的内存（纵向推子，份额对池子）。五条推子并在一起
// 就是整个集群 —— 一眼看出谁醒着、谁睡着、谁快把池子吃光了。
void Dashboard::draw_overview(gfx::DrawList & l) const {
    const ui::Fonts & f = fonts_;
    const auto base_name_of = [](const std::string & p) -> std::string {
        const size_t at = p.find_last_of('/');
        std::string n = at == std::string::npos ? p : p.substr(at + 1);
        if (n.size() > 5 && n.compare(n.size() - 5, 5, ".gguf") == 0) {
            n.resize(n.size() - 5);
        }
        return n;
    };

    put(l, f.regular, "总览", kLeft, kTitleY, 44, kInk);
    char tail[160];
    std::snprintf(tail, sizeof tail, "LT ◀ 1/2 ▶ RT        池子 %.2f / %.2f GB", live_.free_gib, live_.pool_gib);
    put(l, f.regular, tail, kRight, kTitleY, 21, kInk3, gfx::Align::right);

    constexpr int   kStrips = 5;
    const float     top = 214, bottom = 856;
    const float     gap = 20;
    const float     sw = ((kRight - kLeft) - gap * (kStrips - 1)) / kStrips;

    for (int i = 0; i < kStrips; ++i) {
        const Rect r{ kLeft + (sw + gap) * (float) i, top, sw, bottom - top };
        const bool focus = i == ov_cursor_;
        const EngineCard * c = i < (int) live_.engines.size() ? &live_.engines[(size_t) i] : nullptr;
        const std::string kind = c ? c->kind : "";
        const Color      mod  = mod_color(kind);
        const bool reserved = c && c->reserved;
        const bool lit = c && !reserved && c->state != "未配置" && c->state != "未启动";

        // 面板；聚焦的那条描一道暖白边。
        if (focus) {
            l.rounded_rect({ r.x - 2.5f, r.y - 2.5f, r.w + 5, r.h + 5 }, 22, kAccent.with_alpha(0.85f));
        }
        l.rounded_rect(r, 20, kSurface);

        if (!c) {
            continue;
        }
        const float cx = r.x + r.w * 0.5f;

        if (reserved) {
            // 预留席位：只有轮廓和一句实话。
            char port[16];
            std::snprintf(port, sizeof port, ":%d", c->port);
            put(l, f.display, std::to_string(c->slot), cx, r.y + 150, 96, kHair, gfx::Align::center);
            put(l, f.regular, "预留", cx, r.y + 216, 26, kInk3, gfx::Align::center);
            put(l, f.mono, port, cx, r.y + 252, 20, kInk3, gfx::Align::center);
            put(l, f.regular, "留给以后的引擎", cx, r.y + r.h - 60, 19, kInk3, gfx::Align::center);
            continue;
        }

        // 槽位号（大号细体，活着的引擎带模态色）与端口。
        put(l, f.display, std::to_string(c->slot), r.x + 34, r.y + 86, 72, lit ? mod : kInk3);
        char port[16];
        std::snprintf(port, sizeof port, ":%d", c->port);
        put(l, f.mono, port, r.x + r.w - 30, r.y + 56, 21, kInk3, gfx::Align::right);

        // 模态名 + 状态点与状态词。
        put(l, f.semibold, c->name, r.x + 34, r.y + 140, 28, kInk);
        const bool working = c->state == "生成中";
        const Color dot = c->state == "出错"   ? kRed
                        : c->state == "加载中" ? kAmber
                        : c->state == "就绪" || working
                            ? (working ? mod.with_alpha(0.55f + 0.45f * std::sin(clock_ * 5.0f)) : mod)
                            : kInk3;
        l.circle(r.x + 41, r.y + 176, 6, dot);
        put(l, f.regular, c->state, r.x + 58, r.y + 184, 22, c->state == "出错" ? kRed : kInk2);

        // 模型名（未配置就直说）。
        const std::string model = c->model.empty() ? std::string() : base_name_of(c->model);
        if (model.empty()) {
            put(l, f.regular, "还没有指派模型", r.x + 34, r.y + 248, 22, kInk3);
        } else {
            std::string name, build;
            split_name(model, &name, &build);
            put(l, f.regular, f.regular.font->fit(name, 24, r.w - 68), r.x + 34, r.y + 246, 24, kInk);
            if (!build.empty()) {
                put(l, f.regular, f.regular.font->fit(build, 19, r.w - 68), r.x + 34, r.y + 278, 19, kInk3);
            }
        }

        // 参数行与当前任务。
        char line[240];
        float ay = r.y + 336;
        if (kind == "text" && c->ctx > 0) {
            std::snprintf(line, sizeof line, "%uk 上下文 · %s", c->ctx / 1024u,
                          c->kv_type.empty() ? "auto" : c->kv_type.c_str());
            put(l, f.regular, line, r.x + 34, ay, 20, kInk3);
        } else if (kind == "picture" && c->width > 0) {
            std::snprintf(line, sizeof line, "%d×%d · %d 帧 · %d 步", c->width, c->height, c->frames, c->steps);
            put(l, f.regular, line, r.x + 34, ay, 20, kInk3);
        } else if (kind == "speech" && !c->lang.empty()) {
            std::snprintf(line, sizeof line, "%s · 音色 %s", c->lang.c_str(),
                          c->voice.empty() ? "-" : c->voice.c_str());
            put(l, f.regular, line, r.x + 34, ay, 20, kInk3);
        }
        if (!c->activity.empty()) {
            put(l, f.regular, f.regular.font->fit(c->activity, 20, r.w - 68), r.x + 34, ay + 34, 20,
                working ? mod : kInk2);
        }
        // 图像/视频的生成进度条。
        if ((kind == "picture" || kind == "video") && c->steps > 0 && c->step > 0) {
            const float pw = r.w - 68;
            l.rounded_rect({ r.x + 34, ay + 66, pw, 8 }, 4, kHair);
            const float k = tween::clamp01((float) c->step / (float) c->steps);
            l.rounded_rect({ r.x + 34, ay + 66, pw * k, 8 }, 4, mod);
        }

        // 内存推子：真加载了就按实占从底部灌上来；只是「预计」时只画一小截灰条，
        // 数字也标上「预计」，免得看着像已经吃掉了这么多。
        const double gib  = c->model_gib + c->extra_gib;
        const bool   real = c->loaded && gib > 0.001;
        const float track_h = 168;
        const Rect  track{ cx - 3, r.y + r.h - 96 - track_h, 6, track_h };
        l.rounded_rect(track, 3, kHair);
        if (gib > 0.001 && live_.pool_gib > 0.01) {
            if (real) {
                const float share = tween::clamp01((float) (gib / live_.pool_gib));
                const float fh    = std::max(6.0f, track_h * share);
                l.rounded_rect({ track.x, track.y + track_h - fh, track.w, fh }, 3, lit ? mod : kInk3);
            } else {
                l.rounded_rect({ track.x, track.y + track_h - 6, track.w, 6 }, 3, kInk3);
            }
        }
        const std::string mem_text = real ? gb(gib) : (gib > 0.001 ? ("预计 " + gb(gib)) : std::string(kDash));
        put(l, f.regular, f.regular.font->fit(mem_text, 22, r.w - 44), cx, r.y + r.h - 56, 22,
            real ? kInk : kInk3, gfx::Align::center);
        put(l, f.regular, real ? "内存" : "未加载", cx, r.y + r.h - 28, 16, kInk3, gfx::Align::center);
    }

    // 底部：内存总线。五个席位的占用按模态色分段，谁吃了多少一目了然。
    const Rect bar{ kLeft, 884, kRight - kLeft, 28 };
    l.rounded_rect(bar, 14, kHair);
    if (live_.pool_gib > 0.01 && !live_.engines.empty()) {
        float  x    = bar.x;
        double used = 0;
        for (const auto & c : live_.engines) {
            const double gib = c.model_gib + c.extra_gib;
            if (gib <= 0.001 || c.reserved || !c.loaded) {
                continue;   // 没加载进显存的，不算已用 —— 否则总和会超过池子
            }
            const float seg = (float) (gib / live_.pool_gib) * bar.w;
            l.rounded_rect({ x, bar.y, std::max(seg, 3.0f), bar.h }, 14, mod_color(c.kind));
            x += seg;
            used += gib;
        }
        // 图例：每块用它自己的颜色，别再整串一个色（那样看不出谁是谁）
        float lx = kLeft;
        for (const auto & c : live_.engines) {
            const double gib = c.model_gib + c.extra_gib;
            if (gib <= 0.001 || c.reserved || !c.loaded) {
                continue;
            }
            l.rounded_rect({ lx, bar.y + 44, 12, 12 }, 3, mod_color(c.kind));
            lx += 20;
            char part[64];
            std::snprintf(part, sizeof part, "%s %.1f", c.name.c_str(), gib);
            lx += put(l, f.regular, part, lx, bar.y + 56, 19, kInk3) + 26;
        }
        l.rounded_rect({ lx, bar.y + 44, 12, 12 }, 3, kHair);
        lx += 20;
        char rest[64];
        std::snprintf(rest, sizeof rest, "空闲 %.1f GB", std::max(0.0, live_.pool_gib - used));
        put(l, f.regular, rest, lx, bar.y + 56, 19, kInk3);
    }
}

void Dashboard::draw_home(gfx::DrawList & l) const {
    if (home_view_ == 0) {
        draw_overview(l);
        return;
    }
    const ui::Fonts & f = fonts_;
    const bool loaded = !live_.model_label.empty();
    const bool decision = !live_.decision.empty();

    // Left: the model.
    if (!loaded || live_.state == ServerState::no_model) {
        put(l, f.regular, "没有加载模型", kLeft, 260, 26, kInk2);
        put(l, f.regular, "选择模型", kLeft, 340, 64, kInk);
        put(l, f.regular, "它跑在 PS5 的 GPU 上，回答局域网里每台设备的请求。", kLeft, 400, 24, kInk2);
        put(l, f.regular, format("本机 %.0f 个模型", (double) live_.models.size()), kLeft, 444, 24, kInk3);
        if (!live_.address.empty()) {
            put(l, f.regular, "局域网", kLeft, 540, 22, kInk3);
            put(l, f.regular, "http://" + live_.address, kLeft, 586, 32, kInk2);
        }
    } else {
        std::string name, build;
        split_name(live_.model_label, &name, &build);
        put(l, f.regular, !live_.phase.empty() ? "启动中" : decision ? "决策模型" : "语言模型", kLeft, 250, 26,
            kInk2);
        put(l, f.regular, f.regular.font->fit(name, 64, 860), kLeft, 326, 64, kInk);
        std::string detail = build;
        if (live_.ctx > 0) {
            detail += (detail.empty() ? "" : "    ") + format("%.0fk 上下文", live_.ctx / 1024.0);
        }
        if (live_.model_gib > 0) {
            detail += (detail.empty() ? "" : "    ") + gb(live_.model_gib);
        }
        put(l, f.regular, detail, kLeft, 372, 24, kInk3);

        // The state, as a car shows its gear: one word, coloured only when it matters.
        const char * word = live_.state == ServerState::loading ? "加载中"
                          : live_.state == ServerState::generating ? (decision ? "判断中" : "生成中")
                          : live_.state == ServerState::failed ? "已停止" : "Ready";
        const Color dot = live_.state == ServerState::failed ? kRed
                        : live_.state == ServerState::generating ? kModText
                        : live_.state == ServerState::loading ? kInk2.with_alpha(0.5f + 0.5f * std::sin(clock_ * 4.0f)) : kModText;
        l.circle(kLeft + 7, 432, 7, dot);
        put(l, f.regular, word, kLeft + 26, 441, 26, kInk);
        // Where the network reaches it, on the same line.
        if (!live_.address.empty()) {
            put(l, f.regular, "http://" + live_.address, kLeft + 860, 441, 26, kInk2, gfx::Align::right);
        }

        // The large number: speed while serving, progress while loading.
        float big = 0;
        std::string unit;
        bool known = true;
        if (live_.state == ServerState::loading) {
            big = load_shown_ * 100.0f;
            unit = "% 在 GPU 上";
        } else if (decision) {
            // Time per decision (one question answered) over the latest requests:
            // what a decision model is judged by, as Ollaya reports it.
            double seconds = 0;
            int decisions = 0;
            for (const auto & e : live_.activity) {
                if (e.status == 200 && e.questions > 0) {
                    seconds += e.seconds;
                    decisions += e.questions;
                }
            }
            big = decisions ? (float) (1000.0 * seconds / decisions) : 0;
            unit = "毫秒/次决策";
            known = decisions > 0;
        } else {
            big = live_.gen_tps;
            unit = "token/秒";
            known = live_.gen_tps > 0;
            if (!known) {
                // Idle: the last reply's speed, quieter.
                for (auto it = live_.gen_history.rbegin(); it != live_.gen_history.rend(); ++it) {
                    if (*it > 0) {
                        big = *it;
                        unit = "token/秒，上次回复";
                        known = true;
                        break;
                    }
                }
            }
        }
        const bool quiet = live_.state != ServerState::generating && live_.state != ServerState::loading;
        const std::string number = !known ? kDash : big >= 100 || live_.state == ServerState::loading ? format("%.0f", big) : format("%.1f", big);
        const float nw = put(l, f.display, number, kLeft - 8, 660, 232, quiet ? kInk2 : kInk);
        put(l, f.regular, unit, kLeft + nw + 12, 660, 26, kInk2);

        if (live_.state == ServerState::loading) {
            // The model's memory as cells filling column by column, the newest
            // lit and a slow wave over the rest; before the load starts, a light
            // sweeping the empty ones. It never looks stopped.
            constexpr int cols = 60, rows = 4;
            const float cw = (860.0f - 3.0f * (cols - 1)) / cols, ch = 18;
            const int filled = (int) (load_shown_ * cols * rows);
            const float sweep = (0.5f + 0.5f * std::sin(clock_ * 1.7f)) * (cols - 1);
            for (int c = 0; c < cols; ++c) {
                for (int r = 0; r < rows; ++r) {
                    const int i = c * rows + r;
                    const Color cell = i < filled ? kInk.with_alpha(0.45f + 0.4f * (0.5f + 0.5f * std::sin(clock_ * 3.0f - (float) c * 0.22f)))
                                     : i == filled ? kAccent.with_alpha(0.6f + 0.4f * std::sin(clock_ * 8.0f))
                                     : filled == 0 ? gfx::mix(kHair, kInk3, std::max(0.0f, 1.0f - std::fabs((float) c - sweep) / 4.0f))
                                                   : kHair;
                    l.rounded_rect({ kLeft + (cw + 3) * (float) c, 700 + (ch + 3) * (float) r, cw, ch }, 3, cell);
                }
            }
            const double total = live_.model_gib + live_.kv_gib;
            put(l, f.regular,
                !live_.phase.empty() ? live_.phase
                : live_.load_progress < 0.985f ? std::string("正在把权重拷进 GPU 内存") : std::string("准备上下文"),
                kLeft, 822, 22, kInk2);
            if (total > 0) {
                put(l, f.regular, format("%.1f", load_shown_ * total) + " / " + gb(total), kLeft + 860, 822, 22, kInk3,
                    gfx::Align::right);
            }
        } else if (!decision) {
            trace(l, live_.gen_history, { kLeft, 702, 860, 100 }, kInk.with_alpha(0.75f));
        }

        // Two quiet meters: what the model holds, and how much of its context is used.
        const double used = live_.pool_gib - live_.free_gib;
        const float my = 868;
        put(l, f.regular, "内存", kLeft, my, 22, kInk2);
        put(l, f.regular, format("%.1f", used) + " / " + gb(live_.pool_gib), kLeft + 400, my, 22, kInk,
             gfx::Align::right);
        meter(l, kLeft, my + 16, 400, live_.pool_gib > 0 ? (float) (used / live_.pool_gib) : 0, kInk.with_alpha(0.8f));
        put(l, f.regular, "上下文", kLeft + 460, my, 22, kInk2);
        put(l, f.regular, thousands(live_.ctx_used) + " / " + format("%.0fk", live_.ctx / 1024.0), kLeft + 860, my, 22, kInk,
             gfx::Align::right);
        meter(l, kLeft + 460, my + 16, 400, live_.ctx > 0 ? (float) live_.ctx_used / (float) live_.ctx : 0, kInk.with_alpha(0.8f));
    }

    // Right: what the network asks of it, as it happens. A single panel, as a
    // car gives the map, with what it has done since it started at the top,
    // like a trip meter.
    const Rect p{ 1056, 196, kRight - 1056, 728 };
    l.rounded_rect(p, 24, kSurface);
    const float x = p.x + 56, w = p.w - 112;
    put(l, f.regular, "请求", x, p.y + 62, 22, kInk2);
    std::string trip = thousands(live_.served) + " 已回答    " + thousands(live_.prompt_tokens) + " token 输入";
    if (!decision) {
        trip += "    " + thousands(live_.tokens) + " 输出";
    }
    put(l, f.regular, trip, x + w, p.y + 62, 20, kInk3, gfx::Align::right);
    l.line(x, p.y + 90, x + w, p.y + 90, 1.5f, kHair);

    // The conversation: what each device asked, on the right as a message
    // sent, and the model's answer under it on the left, newest at the bottom
    // as in any chat.
    struct Turn {
        const Exchange *         e;
        std::vector<std::string> asked, answered;
        float                    h;
    };
    const float bubble = w * 0.78f;  // the widest a request's bubble gets
    const auto clip = [&](std::vector<std::string> & lines, size_t keep, bool tail, float width) {
        if (lines.size() <= keep) {
            return;
        }
        if (tail) {
            lines.erase(lines.begin(), lines.end() - (long) keep);  // streaming: the newest lines
        } else {
            lines.resize(keep);
            lines.back() = f.regular.font->fit(lines.back() + " \xE2\x80\xA6", 22, width);
        }
    };
    const float top = p.y + 112, bottom = p.y + p.h - 30;
    std::vector<Turn> turns;
    float total = 0;
    for (auto it = live_.activity.rbegin(); it != live_.activity.rend(); ++it) {
        const bool newest = it == live_.activity.rbegin();
        Turn t{ &*it, wrap(f.regular, it->asked.empty() ? std::string(kDash) : it->asked, 22, bubble - 40),
                wrap(f.regular, it->answered, 22, w), 0 };
        clip(t.asked, newest ? 3 : 2, false, bubble - 40);
        clip(t.answered, newest ? 6 : 3, it->status == 0, w);
        t.h = 26 + (float) t.asked.size() * 30 + 20 + 14 + (float) std::max<size_t>(1, t.answered.size()) * 31 + 34 + 26;
        total += t.h;
        turns.push_back(std::move(t));
        if (total > bottom - top) {
            break;  // the oldest shown runs off the top, as a chat scrolls
        }
    }
    if (turns.empty()) {
        put(l, f.regular, "其他设备的请求会以对话形式显示在这里。", x, top + 40, 22, kInk3);
        if (live_.state == ServerState::ready || live_.state == ServerState::generating) {
            put(l, f.regular, "□ 键发示例，△ 键发自己的话。", x, top + 76, 22, kInk3);
        }
    }
    float y = bottom - total;
    for (auto t = turns.rbegin(); t != turns.rend(); ++t) {
        const Exchange & e = *t->e;
        const bool running = e.status == 0;
        const bool fault = e.status >= 400;
        const std::string who = e.client.rfind("127.0.0.1", 0) == 0 ? std::string("本机") : e.client;
        if (y >= top) {
            put(l, f.regular, who + "    " + e.path, x + w, y + 18, 17, kInk3, gfx::Align::right);
        }
        y += 26;
        float bw = 0;
        for (const auto & s : t->asked) {
            bw = std::max(bw, f.regular.measure(s, 22));
        }
        bw += 40;
        const float bh = (float) t->asked.size() * 30 + 20;
        if (y >= top) {
            l.rounded_rect({ x + w - bw, y, bw, bh }, 20, kAccent);
            for (size_t i = 0; i < t->asked.size(); ++i) {
                put(l, f.regular, t->asked[i], x + w - bw + 20, y + 32 + 30.0f * (float) i, 22, kBase);
            }
        }
        y += bh + 14;
        if (t->answered.empty() && running) {
            // Nothing yet: three dots, as a chat shows the other side typing.
            for (int i = 0; i < 3; ++i) {
                l.circle(x + 8 + 20.0f * (float) i, y + 14, 5, kInk2.with_alpha(0.35f + 0.65f * (0.5f + 0.5f * std::sin(clock_ * 6.0f - (float) i))));
            }
        }
        for (size_t i = 0; i < t->answered.size(); ++i) {
            if (y + 31.0f * (float) i >= top) {
                put(l, f.regular, t->answered[i], x, y + 22 + 31.0f * (float) i, 22, fault ? kRed : kInk);
            }
        }
        if (t->answered.empty() && !running && y >= top) {
            put(l, f.regular, kDash, x, y + 22, 22, kInk3);
        }
        y += (float) std::max<size_t>(1, t->answered.size()) * 31 + 6;
        std::string meta = running ? "回答中" : fault ? format("错误 %.0f", (double) e.status)
                                                         : format(e.seconds < 10 ? "%.1f s" : "%.0f s", e.seconds);
        if (!running && !fault && e.questions > 0) {
            meta += format("，%.0f 毫秒/次决策", 1000.0 * e.seconds / e.questions);
        }
        if (y >= top) {
            put(l, f.regular, meta, x, y + 22, 17, fault ? kRed : kInk3);
        }
        y += 28 + 26;
    }
}

// ---- drawing: Models ------------------------------------------------------------------

void Dashboard::draw_models(gfx::DrawList & l) const {
    const ui::Fonts & f = fonts_;
    put(l, f.regular, "模型", kLeft, kTitleY, 44, kInk);

    // The highlight: on a section, or on a row of the list.
    const float hx = in_list_ ? kListX : kLeft - 20;
    const float hw = in_list_ ? kRight - kListX : kRailW;
    const float hh = in_list_ ? kRowH : kRailH;
    l.rounded_rect({ hx, rows_y_.value, hw, hh }, 14, kRaised);

    for (int i = 0; i < kSections; ++i) {
        const float y = kListY + kRailPitch * (float) i;
        const bool on = i == section_;
        if (on) {
            l.rounded_rect({ kLeft - 20, y + 16, 4, kRailH - 32 }, 2, kAccent);
        }
        put(l, f.regular, kSectionNames[i], kLeft, y + 42, 26, on ? kInk : kInk2);
        std::string count;
        if (i == kLocal) {
            count = std::to_string(live_.models.size());
        } else if (i == kDownloads && !market_.downloads.empty()) {
            int active = 0;
            for (const auto & d : market_.downloads) {
                active += d.state != DownloadState::done;
            }
            count = active ? std::to_string(active) : "";
        }
        put(l, f.regular, count, kLeft + kRailW - 44, y + 42, 22, kInk3, gfx::Align::right);
    }

    const Rect area{ kListX, kListY, kRight - kListX, kDockY - 40 - kListY };
    switch (section_) {
        case kSlots: draw_slots(l, area); break;
        case kLocal: draw_local(l, area); break;
        case kSuggested: draw_suggested(l, area); break;
        case kSearch: draw_market(l, area); break;
        default: draw_downloads(l, area); break;
    }
}

// 槽位区：五个席位各占一行。配置（指派了什么模型）和运行（引擎现在怎样）
// 分开说 —— 指了没加载、加载了又出错，是三种不同的事。
void Dashboard::draw_slots(gfx::DrawList & l, const Rect & a) const {
    const ui::Fonts & f = fonts_;
    const auto base_name_of = [](const std::string & p) -> std::string {
        const size_t at = p.find_last_of('/');
        return at == std::string::npos ? p : p.substr(at + 1);
    };
    for (int i = 0; i < 5; ++i) {
        const float y = a.y + kRowPitch * (float) i;
        const EngineCard * c = i < (int) live_.engines.size() ? &live_.engines[(size_t) i] : nullptr;
        if (!c) {
            continue;
        }
        const Color mod = mod_color(c->kind);
        if (c->reserved) {
            char head[48];
            std::snprintf(head, sizeof head, "槽位 %d · :%d", c->slot, c->port);
            put(l, f.regular, head, a.x + 28, y + 36, 26, kInk3);
            put(l, f.regular, "预留给以后的引擎", a.x + 28, y + 66, 20, kInk3);
            continue;
        }
        // 模态色块 + 槽位名 + 端口。
        l.rounded_rect({ a.x + 28, y + 22, 10, 44 }, 5, mod);
        char head[64];
        std::snprintf(head, sizeof head, "槽位 %d · %s", c->slot, c->name.c_str());
        put(l, f.regular, head, a.x + 56, y + 36, 26, kInk);
        put(l, f.mono, ":" + std::to_string(c->port), a.x + 56, y + 66, 19, kInk3);
        // 指派的模型（配置），和引擎的状态（运行），一行一个。
        const std::string model = c->model.empty() ? "未指派" : base_name_of(c->model);
        put(l, f.regular, f.regular.font->fit("模型 " + model, 20, a.w - 560), a.x + 240, y + 36, 20,
            c->model.empty() ? kInk3 : kInk2);
        const double gib = c->model_gib + c->extra_gib;
        put(l, f.regular, gib > 0.001 ? gb(gib) : "", a.x + 240, y + 66, 19, kInk3);
        const Color sc = c->state == "出错" ? kRed : c->state == "就绪" || c->state == "生成中" ? mod : kInk2;
        put(l, f.semibold, c->state, a.x + a.w - 28, y + 50, 22, sc, gfx::Align::right);
    }
    // 底注：语音和图像的引擎约束，摆明不说谎。
    put(l, f.regular, "X 指派模型 · □ 加载／卸载 · 语音槽只随启动加载，图像槽没有运行中卸载", a.x + 28,
        a.y + kRowPitch * 5 + 30, 19, kInk3);
}

// 给槽位指派模型的下拉：本机模型里类型对口的，加一行「不指派」。
void Dashboard::draw_slot_picker(gfx::DrawList & l) const {
    const ui::Fonts & f = fonts_;
    const auto items = slot_items(slot_cursor_ + 1, live_.models);
    const int  n = (int) items.size() + 1, shown = std::min(n, 8);
    const float pitch = 64, w = 820, h = (float) shown * pitch + 24;
    const float below = kListY + kRowPitch * (float) slot_cursor_ + kRowH + 8;
    const Rect  r{ kRight - w, std::min(below, kDockY - 24 - h), w, h };
    l.shadow({ r.x, r.y + 12, r.w, r.h }, 20, 40, kBlack.with_alpha(0.55f));
    l.rounded_rect({ r.x - 1.5f, r.y - 1.5f, r.w + 3, r.h + 3 }, 21.5f, kHair);
    l.rounded_rect(r, 20, kSurface);
    const std::string & now = slot_cursor_ == 0 ? settings_.default_model
                            : slot_cursor_ == 1 ? settings_.sd_diffusion
                                                : settings_.tts_backbone;
    const int first = std::clamp(slot_pick_cursor_ - shown / 2, 0, std::max(0, n - shown));
    for (int i = first; i < first + shown; ++i) {
        const float y = r.y + 12 + pitch * (float) (i - first);
        if (i == slot_pick_cursor_) {
            l.rounded_rect({ r.x + 10, y, r.w - 20, pitch }, 14, kRaised);
        }
        std::string label, note;
        bool current = false;
        if (i == 0) {
            label = "不指派";
            note = "这个槽位空着";
            current = now.empty();
        } else {
            const ModelRow & m = *items[(size_t) i - 1];
            std::string name, build;
            split_name(m.label, &name, &build);
            label = name + "  " + build;
            note = gb(m.size_gib);
            current = m.file == now;
        }
        put(l, f.regular, f.regular.font->fit(label, 24, r.w - 330), r.x + 32, y + 41, 24,
            i == 0 ? kInk3 : kInk);
        put(l, f.regular, f.regular.font->fit(note, 19, 260), r.x + r.w - 76, y + 40, 19, kInk3, gfx::Align::right);
        if (current) {
            const float cx = r.x + r.w - 46, cy = y + pitch * 0.5f;
            l.line(cx - 9, cy, cx - 3, cy + 7, 2.6f, kAccent);
            l.line(cx - 3, cy + 7, cx + 9, cy - 7, 2.6f, kAccent);
        }
    }
    if (n == 1) {
        // 说实话：这两个槽位的引擎不吃模型库，它们读固定路径。
        const char * hint = "模型库里没有这个类型的模型";
        if (slot_pick_) {
            if (slot_cursor_ == 3) {
                hint = "音频模型放 /data/PS5MM/audio/model.gguf，不在这里指派";
            } else if (slot_cursor_ == 4) {
                hint = "三维模型是目录 /data/PS5MM/trellis（7 个文件），不是单个模型";
            }
        }
        put(l, f.regular, f.regular.font->fit(hint, 24, r.w - 64), r.x + 32, r.y + 44, 24, kInk3);
    }
    if (n > shown) {
        const float track = h - 32, thumb = track * (float) shown / (float) n;
        l.rounded_rect({ r.x + r.w - 8, r.y + 16, 3, track }, 1.5f, kHair);
        l.rounded_rect({ r.x + r.w - 8, r.y + 16 + (track - thumb) * (float) first / (float) (n - shown), 3, thumb },
                       1.5f, kInk3);
    }
}

void Dashboard::draw_local(gfx::DrawList & l, const Rect & a) const {
    const ui::Fonts & f = fonts_;
    const int rows = (int) live_.models.size();
    if (rows == 0) {
        put(l, f.regular, "还没有模型", a.x + 28, a.y + 46, 30, kInk);
        put(l, f.regular, "从「推荐」下一个，或把 .gguf 复制到 /data/PS5MM/models。", a.x + 28, a.y + 90, 22, kInk2);
        return;
    }
    const int first = first_visible(local_cursor_, rows);
    for (int i = first; i < std::min(rows, first + kVisibleRows); ++i) {
        const ModelRow & m = live_.models[(size_t) i];
        const float y = a.y + kRowPitch * (float) (i - first);
        std::string name, build;
        split_name(m.label, &name, &build);
        const float nw = put(l, f.regular, f.regular.font->fit(name, 26, 640), a.x + 28, y + 36, 26, m.fits ? kInk : kInk3);
        put(l, f.regular, build, a.x + 28 + nw + 14, y + 36, 21, kInk3);
        // 这一行是什么，由 model_kind() 判出来的 arch 说：文字以外的模型不该
        // 顶着一个"语言"的标签，也不该因为 llama.cpp 的 planner 说放不下就
        // 被标成"太大" —— 它们由各自的引擎自己管内存。
        const std::string kind_label = m.arch == "video"     ? "视频"
                                     : m.arch == "vae"       ? "VAE"
                                     : m.arch == "picture"   ? "图像"
                                     : m.arch == "speech"    ? "语音"
                                     : m.arch == "upscaler"  ? "放大"
                                     : m.arch == "projector" ? "投影器"
                                     : m.arch == "text-encoder" ? "文本编码器"
                                     : m.decision.empty()    ? "语言"
                                                             : "决策";
        std::string meta = kind_label + std::string("    ") + gb(m.size_gib);
        if (m.drive != "Internal storage" && !m.drive.empty()) {
            meta += "    " + m.drive;
        }
        std::string plan = gb_text(m.plan);
        if (plan.rfind("decision model (", 0) == 0 && plan.find("), ") != std::string::npos) {
            plan = plan.substr(plan.find("), ") + 3);  // the kind is said already
        }
        meta += "    " + plan;
        put(l, f.regular, f.regular.font->fit(meta, 20, a.w - 260), a.x + 28, y + 66, 20, kInk3);
        const char * state = m.current ? "运行中" : m.fits ? "" : "太大";
        put(l, f.semibold, state, a.x + a.w - 28, y + 50, 22, m.current ? kModText : kInk3, gfx::Align::right);
    }
}

void Dashboard::draw_suggested(gfx::DrawList & l, const Rect & a) const {
    const ui::Fonts & f = fonts_;
    const int first = first_visible(suggested_cursor_, kSuggestionCount);
    for (int i = first; i < std::min(kSuggestionCount, first + kVisibleRows); ++i) {
        const Suggestion & s = kSuggestions[i];
        const float y = a.y + kRowPitch * (float) (i - first);
        const float nw = put(l, f.regular, s.name, a.x + 28, y + 36, 26, kInk);
        const double bytes = (double) s.model.bytes + (double) (s.mmproj.file ? s.mmproj.bytes : 0);
        put(l, f.regular, format("%.1f GB", bytes / 1073741824.0), a.x + 28 + nw + 14, y + 36, 21, kInk3);
        std::string about = s.decision ? "决策" : s.mmproj.file ? "语言、图像" : "语言";
        if (s.tps > 0) {
            about += format("    %.0f tokens a second here", s.tps);
        }
        about += std::string("    ") + s.about;
        put(l, f.regular, f.regular.font->fit(about, 20, a.w - 260), a.x + 28, y + 66, 20, kInk3);
        // On the console already, on its way, or ready to get.
        std::string state;
        Color c = kInk3;
        for (const auto & m : live_.models) {
            if (m.label + ".gguf" == local_name(s.model)) {
                state = m.current ? "运行中" : "本机模型";
                c = m.current ? kModText : kInk3;
            }
        }
        for (const auto & d : market_.downloads) {
            if (state.empty() && d.repo == s.repo && d.file == s.model.file && d.state != DownloadState::done) {
                state = d.bytes ? format("%.0f%%", 100.0 * (double) d.done / (double) d.bytes) : "等待中";
                c = kInk2;
            }
        }
        if (state.empty() && in_list_ && i == suggested_cursor_) {
            state = "Get";
            c = kAccent;
        }
        put(l, f.semibold, state, a.x + a.w - 28, y + 50, 22, c, gfx::Align::right);
    }
}

void Dashboard::draw_market(gfx::DrawList & l, const Rect & a) const {
    const ui::Fonts & f = fonts_;
    // The searches, as tabs.
    float x = a.x + 28;
    for (int i = 0; i < kMarketChipCount; ++i) {
        const bool on = i == market_chip_;
        const float w = put(l, f.regular, kMarketChips[i], x, a.y + 34, 22, on ? kInk : kInk3);
        if (on) {
            l.rounded_rect({ x, a.y + 48, w, 3 }, 1.5f, kAccent);
        }
        x += w + 36;
    }
    put(l, f.regular, market_.busy ? "Searching" : market_.status, a.x + a.w - 28, a.y + 34, 20, kInk3, gfx::Align::right);
    const float top = a.y + 72;
    const int repos = (int) market_.repos.size();
    const MarketRepo * open = market_.open >= 0 && market_.open < repos ? &market_.repos[(size_t) market_.open] : nullptr;
    if (!market_files_) {
        const int first = first_visible(market_repo_, repos);
        for (int i = first; i < std::min(repos, first + kVisibleRows); ++i) {
            const MarketRepo & r = market_.repos[(size_t) i];
            const float y = top + kRowPitch * (float) (i - first);
            const size_t slash = r.id.find('/');
            put(l, f.regular, f.regular.font->fit(slash == std::string::npos ? r.id : r.id.substr(slash + 1), 26, a.w - 300), a.x + 28,
                 y + 36, 26, kInk);
            put(l, f.regular, (slash == std::string::npos ? std::string() : r.id.substr(0, slash)) + "    " +
                                   thousands(r.downloads) + " downloads", a.x + 28, y + 66, 20, kInk3);
        }
        if (repos == 0 && !market_.busy) {
            put(l, f.regular, "Nothing found", a.x + 28, top + 46, 26, kInk2);
        }
        return;
    }
    if (!open) {
        return;
    }
    put(l, f.regular, open->id, a.x + a.w - 28, top - 4, 20, kInk2, gfx::Align::right);
    const int files = (int) open->files.size();
    const int first = first_visible(market_file_, files);
    for (int i = first; i < std::min(files, first + kVisibleRows); ++i) {
        const MarketFile & m = open->files[(size_t) i];
        const float y = top + kRowPitch * (float) (i - first);
        put(l, f.regular, f.regular.font->fit(m.name, 26, a.w - 300), a.x + 28, y + 36, 26, m.fits == 0 ? kInk3 : kInk);
        const std::string plan = m.checking ? "读取文件头" : m.fits == -1 ? "□ 键检查能否放下" : m.plan;
        put(l, f.regular, f.regular.font->fit(format("%.1f GB", m.bytes / 1073741824.0) + "    " + gb_text(plan), 20, a.w - 300), a.x + 28, y + 66,
             20, kInk3);
        put(l, f.semibold, m.fits == 1 ? "可放入" : m.fits == 0 ? "太大" : "", a.x + a.w - 28, y + 50, 22,
             m.fits == 1 ? kInk2 : kInk3, gfx::Align::right);
    }
}

void Dashboard::draw_downloads(gfx::DrawList & l, const Rect & a) const {
    const ui::Fonts & f = fonts_;
    const int rows = (int) market_.downloads.size();
    if (rows == 0) {
        put(l, f.regular, "没有下载", a.x + 28, a.y + 46, 30, kInk);
        put(l, f.regular, "从「推荐」或「搜索」得到的模型会先在这里等，直到保存。", a.x + 28, a.y + 90, 22, kInk2);
        return;
    }
    const int first = first_visible(dl_cursor_, rows);
    for (int i = first; i < std::min(rows, first + kVisibleRows); ++i) {
        const Download & d = market_.downloads[(size_t) i];
        const float y = a.y + kRowPitch * (float) (i - first);
        put(l, f.regular, f.regular.font->fit(d.file, 26, a.w - 320), a.x + 28, y + 34, 26,
             d.state == DownloadState::done ? kInk2 : kInk);
        const bool fault = d.state == DownloadState::failed;
        put(l, f.regular, f.regular.font->fit(download_line(d), 20, a.w - 320), a.x + 28, y + 64, 20, fault ? kRed : kInk3);
        const char * state = d.state == DownloadState::running ? "" : d.state == DownloadState::paused ? "已暂停"
                           : d.state == DownloadState::failed ? "Failed" : d.state == DownloadState::done ? "Saved"
                           : d.state == DownloadState::retrying ? "Retrying" : "等待中";
        if (d.state == DownloadState::running && d.bytes) {
            const float share = (float) ((double) d.done / (double) d.bytes);
            meter(l, a.x + a.w - 248, y + 42, 220, share, kAccent);
        } else {
            put(l, f.semibold, state, a.x + a.w - 28, y + 50, 22, fault ? kRed : kInk3, gfx::Align::right);
        }
    }
}

// ---- drawing: Endpoints -----------------------------------------------------------------

namespace {

// 每个引擎回答的路由，一个槽位一组。端口写死（ports.hpp），界面只读不改。
struct EpRow {
    int         slot;
    int         port;
    const char * method;
    const char * path;
    const char * about;
};

// 端点页用：表里第 1 列是「哪一组」（1 文字 / 2 图像 / 3 语音），
// 实际端口要按设置里的槽位现算 —— 槽位改了端口就跟着变。
int ep_port_of(const Settings & s, int group) {
    const int slot = group == 1 ? s.text_slot : group == 2 ? s.picture_slot : s.speech_slot;
    return 8000 + slot;
}

constexpr EpRow kEndpoints[] = {
    { 1, 8001, "POST", "/v1/chat/completions", "OpenAI 聊天：流式、工具调用" },
    { 1, 8001, "POST", "/v1/messages", "Anthropic Messages，给 Claude Code 用" },
    { 1, 8001, "POST", "/v1/completions", "纯文本补全" },
    { 1, 8001, "POST", "/v1/systemone", "TypeSafe 决策：选择、打分、是非题" },
    { 1, 8001, "GET", "/v1/models", "已加载的文字模型" },
    { 1, 8001, "GET", "/health", "就绪还是加载中" },
    { 2, 8002, "POST", "/sdapi/v1/txt2img", "文生图（A1111 兼容）" },
    { 2, 8002, "POST", "/sdapi/v1/txt2vid", "文生视频" },
    { 2, 8002, "POST", "/v1/images/generations", "OpenAI 图像" },
    { 2, 8002, "POST", "/sdapi/v1/upscale", "ESRGAN 放大" },
    { 2, 8002, "GET", "/sdapi/v1/options", "当前画图参数" },
    { 2, 8002, "GET", "/health", "引擎与模型状态" },
    { 3, 8003, "POST", "/v1/audio/speech", "文字转语音，回 WAV" },
    { 3, 8003, "GET", "/v1/audio/voices", "可用的参考音色" },
    { 3, 8003, "GET", "/health", "引擎与模型状态" },
};
constexpr int kEndpointCount = 15;

// 聚焦那一行的调用示例。base 是带端口的基址（http://192.168.1.19:8001）。
std::vector<std::string> ep_example(int row, const std::string & base) {
    switch (row) {
        case 0:
            return { "curl " + base + "/v1/chat/completions \\", "  -H 'Content-Type: application/json' \\",
                     "  -d '{", "    \"messages\": [", "      {\"role\": \"user\",", "       \"content\": \"hello, PS5\"}",
                     "    ]", "  }'" };
        case 1:
            return { "curl " + base + "/v1/messages \\", "  -H 'Content-Type: application/json' \\",
                     "  -d '{", "    \"model\": \"claude-sonnet-4-5\",", "    \"max_tokens\": 1024,",
                     "    \"messages\": [", "      {\"role\": \"user\", \"content\": \"hello\"}", "    ]", "  }'" };
        case 2:
            return { "curl " + base + "/v1/completions \\", "  -H 'Content-Type: application/json' \\",
                     "  -d '{\"prompt\": \"PS5 上跑 AI\",", "    \"max_tokens\": 64}'" };
        case 3:
            return { "curl " + base + "/v1/systemone \\", "  -H 'Content-Type: application/json' \\",
                     "  -d '{", "    \"state\": \"Refund me now or I cancel.\",", "    \"questions\": {",
                     "      \"angry\": {", "        \"type\": \"noul\",",
                     "        \"instructions\": \"Is the customer angry?\"", "      }", "    }", "  }'" };
        case 6:
            return { "curl " + base + "/sdapi/v1/txt2img \\", "  -H 'Content-Type: application/json' \\",
                     "  -d '{\"prompt\": \"a red fox in snow\",", "    \"width\": 832, \"height\": 480,",
                     "    \"steps\": 20}'" };
        case 7:
            return { "curl " + base + "/sdapi/v1/txt2vid \\", "  -H 'Content-Type: application/json' \\",
                     "  -d '{\"prompt\": \"waves on a beach\",", "    \"frames\": 33, \"fps\": 16}'" };
        case 8:
            return { "curl " + base + "/v1/images/generations \\", "  -H 'Content-Type: application/json' \\",
                     "  -d '{\"prompt\": \"a red fox in snow\",", "    \"size\": \"832x480\"}'" };
        case 9:
            return { "curl " + base + "/sdapi/v1/upscale \\", "  -H 'Content-Type: application/json' \\",
                     "  -d '{\"image\": \"<base64>\",", "    \"upscale\": 2}'" };
        case 12:
            return { "curl " + base + "/v1/audio/speech \\", "  -H 'Content-Type: application/json' \\",
                     "  -d '{\"input\": \"你好，世界\",", "    \"voice\": \"default\",", "    \"lang\": \"zh\"}'",
                     "  --output speech.wav" };
        default:
            // GET 类：直接打就行
            return {};
    }
}

}  // namespace

void Dashboard::update_endpoints(const hui::InputFrame & input, ui::Feedback & feedback) {
    if (walk(input, ep_cursor_, kEndpointCount, feedback)) {
        // 光标跟走：分组头让行高不齐，按像素算它的位置，滚到看得见。
        float y = 0;
        int   slot = 0;
        float at = 0, h = 56;
        for (int i = 0; i < kEndpointCount; ++i) {
            if (kEndpoints[i].slot != slot) {
                slot = kEndpoints[i].slot;
                y += 64;  // 分组头
            }
            if (i == ep_cursor_) {
                at = y;
                break;
            }
            y += 56;
        }
        const float view = 926 - 236;
        if (at < ep_scroll_) {
            ep_scroll_ = at;
        } else if (at + h > ep_scroll_ + view) {
            ep_scroll_ = at + h - view;
        }
    }
}

void Dashboard::draw_endpoints(gfx::DrawList & l) const {
    const ui::Fonts & f = fonts_;
    put(l, f.regular, "端点", kLeft, kTitleY, 44, kInk);
    const std::string host = live_.host.empty() ? std::string("<PS5 地址>") : live_.host;
    put(l, f.regular, "局域网基址 http://" + host + " —— 每个引擎一个端口，互不漂移", kRight, kTitleY, 21,
        kInk3, gfx::Align::right);

    // 左：分组的路由表（按像素滚动，光标在 update_endpoints 里跟走）。
    const float top = 236, bottom = 926;
    float y = top - ep_scroll_;
    int   slot = 0;
    l.push_clip({ kLeft - 20, top, 1120 - kLeft + 20, bottom - top });
    for (int i = 0; i < kEndpointCount; ++i) {
        const EpRow & e = kEndpoints[i];
        if (e.slot != slot) {
            slot = e.slot;
            const EngineCard * c = slot - 1 < (int) live_.engines.size() ? &live_.engines[(size_t) slot - 1] : nullptr;
            const Color mod = c ? mod_color(c->kind) : kInk3;
            if (y + 44 > top) {
                l.circle(kLeft + 7, y + 30, 7, mod);
                char head[64];
                std::snprintf(head, sizeof head, "#%d · %s · :%d", slot, c ? c->name.c_str() : "?",
                              ep_port_of(settings_, e.slot));
                put(l, f.semibold, head, kLeft + 26, y + 38, 24, kInk);
                if (c) {
                    put(l, f.regular, c->state, 1120, y + 38, 20,
                        c->state == "出错" ? kRed : kInk3, gfx::Align::right);
                }
            }
            y += 64;
        }
        const bool focus = i == ep_cursor_;
        if (focus && y + 56 > top && y < bottom) {
            l.rounded_rect({ kLeft - 20, y, 1120 - kLeft + 20, 56 }, 12, kRaised);
        }
        if (y + 56 > top && y < bottom) {
            const Color mod = mod_color(slot == 1 ? "text" : slot == 2 ? "picture" : "speech");
            put(l, f.mono, e.method, kLeft + 8, y + 36, 20, mod);
            put(l, f.mono, e.path, kLeft + 96, y + 36, 22, focus ? kInk : kInk2);
        }
        y += 56;
    }
    // 预留席位：两张灰行，不可选。
    for (int s = 4; s <= 5; ++s) {
        if (y + 56 > top && y < bottom) {
            char line[80];
            std::snprintf(line, sizeof line, "槽位 %d · 预留 · :%d", s, 8000 + s);
            put(l, f.regular, line, kLeft + 26, y + 36, 20, kInk3);
            put(l, f.regular, "未开放", 1120, y + 36, 20, kInk3, gfx::Align::right);
        }
        y += 56;
    }
    l.pop_clip();

    // 右：聚焦端点的说明和调用示例。
    const Rect p{ 1184, 236, kRight - 1184, 688 };
    l.rounded_rect(p, 24, kSurface);
    const EpRow & e = kEndpoints[std::clamp(ep_cursor_, 0, kEndpointCount - 1)];
    const Color mod = mod_color(e.slot == 1 ? "text" : e.slot == 2 ? "picture" : "speech");
    l.circle(p.x + 55, p.y + 62, 7, mod);
    put(l, f.semibold, e.about, p.x + 76, p.y + 70, 26, kInk);
    const std::string base = "http://" + host + ":" + std::to_string(ep_port_of(settings_, e.slot));
    put(l, f.mono, std::string(e.method) + "  " + base + e.path, p.x + 48, p.y + 122, 20, kInk2);
    l.line(p.x + 48, p.y + 152, p.x + p.w - 48, p.y + 152, 1.5f, kHair);
    put(l, f.regular, "试一试", p.x + 48, p.y + 196, 22, kInk2);
    const auto code = ep_example(ep_cursor_, base);
    if (code.empty()) {
        put(l, f.mono, "curl " + base + e.path, p.x + 48, p.y + 246, 21, kInk);
    } else {
        float cy = p.y + 246;
        for (const auto & line : code) {
            put(l, f.mono, f.mono.font->fit(line, 20, p.w - 96), p.x + 48, cy, 20, kInk);
            cy += 32;
        }
    }
    // 引擎不在线就说实话。
    const EngineCard * c = e.slot - 1 < (int) live_.engines.size() ? &live_.engines[(size_t) e.slot - 1] : nullptr;
    if (c && c->state != "就绪" && c->state != "生成中") {
        l.line(p.x + 48, p.y + p.h - 120, p.x + p.w - 48, p.y + p.h - 120, 1.5f, kHair);
        put(l, f.regular, "这个引擎现在" + c->state + "，调用会失败或排队。", p.x + 48, p.y + p.h - 72, 20, kAmber);
    }
}

// ---- drawing: Monitor -----------------------------------------------------------------

// 监控页：左边四张图表，右上每个引擎手里的活，右下日志。
// 温度功耗那条线还在老位置 —— 车开了多久，仪表就该在哪。
void Dashboard::draw_monitor(gfx::DrawList & l) const {
    const ui::Fonts & f = fonts_;
    put(l, f.regular, "监控", kLeft, kTitleY, 44, kInk);
    const char * ranges[] = { "最近 2 分钟", "最近 1 小时" };
    float rx = 1224;
    for (int i = 1; i >= 0; --i) {
        const bool on = (i == 1) == console_hour_;
        rx -= f.regular.measure(ranges[i], 22);
        const float tw = put(l, f.regular, ranges[i], rx, kTitleY - 8, 22, on ? kInk : kInk3);
        if (on) {
            l.rounded_rect({ rx, kTitleY + 6, tw, 3 }, 1.5f, kAccent);
        }
        rx -= 40;
    }

    struct Chart {
        const char *               name;
        const std::vector<float> & v;
        const char *               unit;
        bool                       share;   // 0..1, shown as a percentage
        bool                       sensor;  // read through ps5-exporter
    };
    const bool hour = console_hour_;
    const Chart charts[] = {
        { "温度", hour ? live_.temp_hour : live_.temp_history, "\xC2\xB0" "C", false, true },
        { "功耗", hour ? live_.power_hour : live_.power_history, " W", false, true },
        { "GPU", hour ? live_.gpu_hour : live_.gpu_history, "%", true, false },
        { "CPU", hour ? live_.cpu_hour : live_.cpu_history, "%", true, false },
    };
    const float cw = (1224 - kLeft - 32) / 2, ch = (926 - kListY - 32) / 2;
    for (int i = 0; i < 4; ++i) {
        const Chart & c = charts[i];
        const Rect r{ kLeft + (cw + 32) * (float) (i % 2), kListY + (ch + 32) * (float) (i / 2), cw, ch };
        l.rounded_rect(r, 20, kSurface);
        put(l, f.regular, c.name, r.x + 32, r.y + 50, 22, kInk2);
        if (c.v.empty()) {
            put(l, f.regular, hour ? "30 秒后出现第一个点" : c.sensor ? "未读取" : kDash, r.x + 32,
                r.y + r.h * 0.5f + 8, 22, kInk3);
            if (c.sensor && !hour) {
                put(l, f.regular, "elfldr 在跑时，app 会加载 ps5-exporter 来读取", r.x + 32, r.y + r.h * 0.5f + 44,
                    19, kInk3);
            }
            continue;
        }
        float lo = c.v[0], hi = c.v[0], sum = 0;
        for (float x : c.v) {
            lo = std::min(lo, x);
            hi = std::max(hi, x);
            sum += x;
        }
        const auto show = [&](float x) { return c.share ? format("%.0f%%", 100.0 * x) : format("%.0f", x) + c.unit; };
        put(l, f.regular, show(c.v.back()), r.x + r.w - 32, r.y + 54, 34, kInk, gfx::Align::right);
        // The scale: a share runs 0 to 100%; the rest a little past what was seen, in fives.
        const float pad = std::max(4.0f, (hi - lo) * 0.25f);
        const float bot = c.share ? 0.0f : std::max(0.0f, std::floor((lo - pad) / 5) * 5);
        const float top = c.share ? 1.0f : std::ceil((hi + pad) / 5) * 5;
        const Rect g{ r.x + 100, r.y + 96, r.w - 132, r.h - 96 - 70 };
        for (int k = 0; k < 3; ++k) {
            const float gy = g.y + g.h * (float) k * 0.5f;
            l.line(g.x, gy, g.x + g.w, gy, 1.0f, kHair);
            put(l, f.regular, show(top - (top - bot) * 0.5f * (float) k), g.x - 14, gy + 6, 16, kInk3, gfx::Align::right);
        }
        plot(l, c.v, g, kInk.with_alpha(0.85f), bot, top);
        put(l, f.regular, "低 " + show(lo) + "    平均 " + show(sum / (float) c.v.size()) + "    高 " + show(hi),
            r.x + 32, r.y + r.h - 26, 19, kInk3);
    }

    // 右上：每个引擎手里的活。文字看速度，图像/视频看步数，语音看请求数。
    const Rect p{ 1264, kListY, kRight - 1264, 280 };
    l.rounded_rect(p, 24, kSurface);
    put(l, f.regular, "引擎", p.x + 40, p.y + 50, 22, kInk2);
    char top_right[160];
    std::snprintf(top_right, sizeof top_right, "%.0f W · %.0f\xC2\xB0" "C · 内存 %.1f/%.1f GB",
                  live_.soc_power_w, live_.soc_temp, live_.pool_gib - live_.free_gib, live_.pool_gib);
    put(l, f.regular, top_right, p.x + p.w - 40, p.y + 50, 18, kInk3, gfx::Align::right);
    float ey = p.y + 78;
    int shown = 0;
    for (const auto & c : live_.engines) {
        if (c.reserved || shown >= 3) {
            continue;
        }
        ++shown;
        const Color mod = mod_color(c.kind);
        l.circle(p.x + 46, ey + 18, 6,
                 c.state == "出错" ? kRed : c.state == "就绪" || c.state == "生成中" ? mod : kInk3);
        put(l, f.semibold, c.name, p.x + 64, ey + 26, 23, kInk);
        put(l, f.regular, c.state, p.x + p.w - 40, ey + 26, 20, c.state == "出错" ? kRed : kInk3,
            gfx::Align::right);
        // 手里的活：一行字或一条进度。
        std::string doing = c.activity;
        if (doing.empty()) {
            doing = c.state == "就绪" ? "空闲" : "";
        }
        put(l, f.regular, f.regular.font->fit(doing, 19, p.w - 128), p.x + 64, ey + 54, 19, kInk2);
        if ((c.kind == "picture" || c.kind == "video") && c.steps > 0 && c.step > 0) {
            const float pw = p.w - 128;
            l.rounded_rect({ p.x + 64, ey + 64, pw, 6 }, 3, kHair);
            l.rounded_rect({ p.x + 64, ey + 64, pw * tween::clamp01((float) c.step / (float) c.steps), 6 }, 3, mod);
        }
        ey += 78;
    }
    if (shown == 0) {
        put(l, f.regular, "引擎状态还没上报", p.x + 40, ey + 30, 20, kInk3);
    }

    // 右下：日志（原来在设置的「诊断」里，搬到这和其它信号住一起）。
    l.rounded_rect({ 1264, 540, kRight - 1264, 386 }, 24, kSurface);
    draw_logs(l, { 1264, 540, kRight - 1264, 386 });
}

// ---- drawing: Settings ----------------------------------------------------------------

void Dashboard::draw_settings(gfx::DrawList & l) const {
    const ui::Fonts & f = fonts_;
    put(l, f.regular, "设置", kLeft, kTitleY, 44, kInk);
    l.rounded_rect({ in_rows_ ? kListX : kLeft - 20, rows_y_.value, in_rows_ ? kRight - kListX : kRailW,
                     in_rows_ ? kRowH : kRailH }, 14, kRaised);
    for (int i = 0; i < kCategoryCount; ++i) {
        const float y = kListY + kRailPitch * (float) i;
        const bool on = i == setting_category_;
        if (on) {
            l.rounded_rect({ kLeft - 20, y + 16, 4, kRailH - 32 }, 2, kAccent);
        }
        put(l, f.regular, kCategories[i].name, kLeft, y + 42, 26, on ? kInk : kInk2);
    }
    const SettingCategory & c = kCategories[setting_category_];
    for (int i = 0; i < c.count; ++i) {
        const SettingRow & r = c.rows[i];
        const float y = kListY + kRowPitch * (float) i;
        put(l, f.regular, r.label, kListX + 28, y + 36, 26, kInk);
        put(l, f.regular, r.help, kListX + 28, y + 66, 20, kInk3);
        const float cy = y + kRowH * 0.5f;
        if (is_toggle(r.id)) {
            toggle_switch(l, kRight - 28, cy, toggle_value(settings_, r.id));
        } else if (r.id != Setting::clear_scratch) {
            const bool focus = in_rows_ && i == setting_row_;
            Color c = focus ? kInk : kInk2;
            if (setting_warns(settings_, r.id, live_)) {
                c = kRed;   // 这一行现在会把内存撑爆
            }
            put(l, f.regular, setting_text(settings_, r.id, live_.models, live_.drives), kRight - 68, y + 50, 24, c,
                 gfx::Align::right);
            // A chevron down: X opens a list of the choices.
            l.line(kRight - 44, cy - 4, kRight - 36, cy + 4, 2.4f, c);
            l.line(kRight - 36, cy + 4, kRight - 28, cy - 4, 2.4f, c);
        } else if (live_.scratch_gib > 0) {
            put(l, f.regular, format("%.1f GB in it", live_.scratch_gib), kRight - 28, y + 50, 22, kInk2,
                 gfx::Align::right);
        }
    }
}

// A row's choices in a list that drops from it, the one set now ticked.
void Dashboard::draw_picker(gfx::DrawList & l) const {
    const ui::Fonts & f = fonts_;
    if (multi_) {
        // 勾选清单：每行前面一个方框，勾上的画对勾
        const auto items = boot_items(live_.models);
        const int  n = (int) items.size(), shown = std::min(n, 8);
        const float pitch = 64, w = 760, h = (float) shown * pitch + 24;
        const float below = kListY + kRowPitch * (float) setting_row_ + kRowH + 8;
        const Rect  r{ kRight - w, std::min(below, kDockY - 24 - h), w, h };
        l.shadow({ r.x, r.y + 12, r.w, r.h }, 20, 40, kBlack.with_alpha(0.55f));
        l.rounded_rect({ r.x - 1.5f, r.y - 1.5f, r.w + 3, r.h + 3 }, 21.5f, kHair);
        l.rounded_rect(r, 20, kSurface);
        const int first = std::clamp(picker_cursor_ - shown / 2, 0, std::max(0, n - shown));
        for (int i = first; i < first + shown; ++i) {
            const ModelRow & m = *items[(size_t) i];
            const float y = r.y + 12 + pitch * (float) (i - first);
            if (i == picker_cursor_) {
                l.rounded_rect({ r.x + 10, y, r.w - 20, pitch }, 14, kRaised);
            }
            const bool ticked = std::find(settings_.boot_models.begin(), settings_.boot_models.end(), m.file) !=
                                settings_.boot_models.end();
            const float bx = r.x + 30, by = y + pitch * 0.5f - 11;
            l.rounded_rect({ bx, by, 22, 22 }, 6, ticked ? kAccent : kHair);
            if (ticked) {
                l.line(bx + 5, by + 11, bx + 9, by + 16, 2.6f, kBlack);
                l.line(bx + 9, by + 16, bx + 17, by + 4, 2.6f, kBlack);
            }
            std::string name, build;
            split_name(m.label, &name, &build);
            put(l, f.regular, f.regular.font->fit(name, 24, r.w - 320), r.x + 68, y + 41, 24, kInk);
            put(l, f.regular, f.regular.font->fit(build, 19, 200), r.x + r.w - 100, y + 40, 19, kInk3,
                gfx::Align::right);
        }
        if (n > shown) {
            const float track = h - 32, thumb = track * (float) shown / (float) n;
            l.rounded_rect({ r.x + r.w - 8, r.y + 16, 3, track }, 1.5f, kHair);
            l.rounded_rect({ r.x + r.w - 8, r.y + 16 + (track - thumb) * (float) first / (float) (n - shown), 3, thumb },
                           1.5f, kInk3);
        }
        if (n == 0) {
            put(l, f.regular, "模型库还是空的", r.x + 32, r.y + 44, 24, kInk3);
        }
        return;
    }
    const auto all = choices_of(settings_, kCategories[setting_category_].rows[setting_row_].id, live_.models, live_.drives);
    const int   n = (int) all.size(), shown = std::min(n, 7);
    const float pitch = 64, w = 700, h = (float) shown * pitch + 24;
    const float below = kListY + kRowPitch * (float) setting_row_ + kRowH + 8;
    const Rect  r{ kRight - w, std::min(below, kDockY - 24 - h), w, h };
    l.shadow({ r.x, r.y + 12, r.w, r.h }, 20, 40, kBlack.with_alpha(0.55f));
    l.rounded_rect({ r.x - 1.5f, r.y - 1.5f, r.w + 3, r.h + 3 }, 21.5f, kHair);
    l.rounded_rect(r, 20, kSurface);
    const int first = std::clamp(picker_cursor_ - shown / 2, 0, std::max(0, n - shown));
    for (int i = first; i < first + shown; ++i) {
        const Choice & c = all[(size_t) i];
        const float y = r.y + 12 + pitch * (float) (i - first);
        if (i == picker_cursor_) {
            l.rounded_rect({ r.x + 10, y, r.w - 20, pitch }, 14, kRaised);
        }
        put(l, f.regular, f.regular.font->fit(c.label, 24, r.w - 330), r.x + 32, y + 41, 24, kInk);
        put(l, f.regular, f.regular.font->fit(c.note, 19, 260), r.x + r.w - 76, y + 40, 19, kInk3, gfx::Align::right);
        if (c.current) {
            const float cx = r.x + r.w - 46, cy = y + pitch * 0.5f;
            l.line(cx - 9, cy, cx - 3, cy + 7, 2.6f, kAccent);
            l.line(cx - 3, cy + 7, cx + 9, cy - 7, 2.6f, kAccent);
        }
    }
    if (n > shown) {
        // How far down the list is, as a thin bar.
        const float track = h - 32, thumb = track * (float) shown / (float) n;
        l.rounded_rect({ r.x + r.w - 8, r.y + 16, 3, track }, 1.5f, kHair);
        l.rounded_rect({ r.x + r.w - 8, r.y + 16 + (track - thumb) * (float) first / (float) (n - shown), 3, thumb }, 1.5f, kInk3);
    }
}

void Dashboard::draw_logs(gfx::DrawList & l, const Rect & a) const {
    const ui::Fonts & f = fonts_;
    float x = a.x + 40;
    put(l, f.regular, "日志", x, a.y + 40, 22, kInk2);
    x += f.regular.measure("日志", 22) + 40;
    const char * tabs[] = { "App", "服务器" };
    for (int i = 0; i < 2; ++i) {
        const bool on = (i == 1) == log_llama_;
        const float w = put(l, f.regular, tabs[i], x, a.y + 40, 24, on ? kInk : kInk3);
        if (on) {
            l.rounded_rect({ x, a.y + 54, w, 3 }, 1.5f, kAccent);
        }
        x += w + 36;
    }
    put(l, f.regular, log_errors_ ? "仅错误和警告" : "全部", a.x + a.w - 28, a.y + 40, 20, kInk3,
         gfx::Align::right);
    const auto & v = log_view();
    const int last = (int) v.size() - log_scroll_;
    const int first = std::max(0, last - kLogLines);
    float y = a.y + 96;
    for (int i = first; i < last; ++i) {
        const int level = log_level(v[(size_t) i]);
        put(l, f.mono, f.mono.font->fit(v[(size_t) i], 18, a.w - 56), a.x + 28, y, 18,
             level == 2 ? kRed : level == 1 ? kInk : kInk2);
        y += kLogLineH;
    }
    if (v.empty()) {
        put(l, f.regular, "这里还空着", a.x + 28, a.y + 120, 24, kInk3);
    }
}

// ---- drawing: dialogs and the busy sheet -------------------------------------------------

namespace {

void sheet(gfx::DrawList & l, const Rect & r) {
    l.rounded_rect({ 0, 0, 1920, 1080 }, 0, kBlack.with_alpha(0.62f));
    l.shadow({ r.x, r.y + 16, r.w, r.h }, 24, 48, kBlack.with_alpha(0.5f));
    l.rounded_rect(r, 24, kSurface);
}

}  // namespace

void Dashboard::draw_dialogs(gfx::DrawList & l) const {
    if (!(page_ == kModelsPage && (market_confirm_ || market_space_))) {
        return;
    }
    const ui::Fonts & f = fonts_;
    const Rect r{ 960 - 440, 540 - 170, 880, 340 };
    sheet(l, r);
    ui::GlyphStyle style = ui::GlyphStyle::dark();
    style.label = kInk2;
    ui::HintLayout layout;
    layout.size = 32;
    layout.text_size = 22;
    layout.cy = r.y + r.h - 56;
    if (market_confirm_) {
        put(l, f.semibold, "先卸载模型？", r.x + 56, r.y + 86, 34, kInk);
        put(l, f.regular, "释放内存后下载更快，之后可以再加载模型。", r.x + 56, r.y + 136, 22, kInk2);
        const ui::Hint h[] = { { ui::Button::circle, "取消" }, { ui::Button::cross, "保留在内存" }, { ui::Button::triangle, "卸载并下载" } };
        ui::draw_hints(l, fonts_, style, h, 3, r.x + r.w - 56, true, layout);
    } else {
        put(l, f.semibold, "那里空间不够", r.x + 56, r.y + 86, 34, kInk);
        put(l, f.regular, market_dir_.empty() ? "没有硬盘放得下。清点空间再试。"
                                               : "可放入 " + drive_name(market_dir_) + ".",
             r.x + 56, r.y + 136, 22, kInk2);
        const ui::Hint h[] = { { ui::Button::circle, "取消" }, { ui::Button::cross, "保存到那里" } };
        ui::draw_hints(l, fonts_, style, h, market_dir_.empty() ? 1 : 2, r.x + r.w - 56, true, layout);
    }
}

// Slow work, often the app restarting for a model: the whole screen, the
// name and what is happening, and a bar that keeps moving so a pause never
// looks like a hang.
void Dashboard::draw_busy(gfx::DrawList & l) const {
    const ui::Fonts & f = fonts_;
    l.rounded_rect({ 0, 0, 1920, 1080 }, 0, kBase);
    // 五笔标呼吸：等待的时候，品牌符号自己动着，就不像卡死。
    const float mh = 130;
    const float mw = 5 * (mh * 0.14f) + 4 * (mh * 0.16f);
    draw_mark(l, 960 - mw * 0.5f, 340, mh, live_, clock_);
    put(l, f.semibold, "PS5MM", 960, 560, 96, kInk, gfx::Align::center);
    put(l, f.regular, f.regular.font->fit(busy_title_, 32, 1400), 960, 640, 32, kInk, gfx::Align::center);
    put(l, f.regular, f.regular.font->fit(busy_text_, 24, 1400), 960, 686, 24, kInk2, gfx::Align::center);
    const float track = 360, seg = 96;
    const float t = 0.5f + 0.5f * std::sin(clock_ * 2.4f);
    l.rounded_rect({ 960 - track * 0.5f, 740, track, 3 }, 1.5f, kHair);
    l.rounded_rect({ 960 - track * 0.5f + (track - seg) * t, 740, seg, 3 }, 1.5f, kInk);
}

}  // namespace ps5lm
